---
import BlueprintLayout from '../layouts/BlueprintLayout.astro';
import FooterV2 from '../components/v2/FooterV2.astro';

const equipos = [
  'Computadores y laptops', 'Monitores y pantallas', 'Teléfonos y tablets',
  'Impresoras y escáneres', 'Servidores y networking', 'Televisores',
  'Baterías y UPS', 'Cámaras y equipos AV', 'Cables y periféricos',
  'Equipos industriales', 'Luminarias LED/CFL', 'Electrodomésticos',
];

const pasos = [
  {
    n: '01', title: 'Solicita el retiro',
    desc: 'Completa el formulario o escríbenos. Respondemos en menos de 24 horas con disponibilidad.',
    seal: '[ RESPUESTA EN 24H ]',
  },
  {
    n: '02', title: 'Coordinamos la logística',
    desc: 'Definimos fecha y punto de retiro. Coordinamos con partners logísticos certificados — tú no transportas nada.',
    seal: '[ VÍA PARTNERS CERTIFICADOS ]',
  },
  {
    n: '03', title: 'Retiro y acta firmada',
    desc: 'El equipo llega, carga los RAEE y emite acta de recepción firmada con detalle de lo retirado.',
    seal: '[ TRAZABILIDAD DESDE EL PRIMER KILO ]',
  },
  {
    n: '04', title: 'Tratamiento y valorización',
    desc: 'Los equipos son procesados por gestores autorizados: destrucción de datos, desmantelamiento y recuperación de materiales.',
    seal: '[ PROCESAMIENTO CERTIFICADO ]',
  },
  {
    n: '05', title: 'Certificado de disposición final',
    desc: 'Recibes el certificado de valorización con todos los datos legales. Válido para ESG y auditorías REP.',
    seal: '[ CERTIFICADO EN 5 DÍAS HÁBILES ]',
  },
];

const riesgos = [
  { code: 'SMA', title: 'Multas SMA', desc: 'Hasta 10.000 UTM por disposición inadecuada de RAEE bajo la Ley REP.' },
  { code: 'SEC', title: 'Riesgo de datos', desc: 'Equipos con información sensible mal destruidos exponen a tu empresa a filtraciones.' },
  { code: 'AMB', title: 'Daño ambiental', desc: 'Plomo, mercurio y cadmio contaminan suelos y aguas subterráneas.' },
  { code: 'ESG', title: 'Daño reputacional', desc: 'Perder licitaciones y clientes que exigen cumplimiento ambiental documentado.' },
];

const sectores = [
  'Minería', 'Banca y Finanzas', 'Retail', 'Telecomunicaciones',
  'Salud', 'Educación', 'Gobierno y Municipios', 'Manufactura',
  'Energía y Utilities', 'Tecnología', 'Logística', 'Hotelería',
];

const faqs = [
  {
    q: '¿Cuánto cuesta el servicio de retiro?',
    a: 'El costo depende del volumen, tipo de equipos y ubicación. Para volúmenes medianos y grandes el servicio puede ser sin costo adicional dado el valor de los materiales recuperados. Cotiza sin compromiso.',
  },
  {
    q: '¿En qué regiones operan?',
    a: 'Operamos en la macrozona norte de Chile (III Región de Atacama y IV Región de Coquimbo). Desde 2027 planificamos expandir la cobertura.',
  },
  {
    q: '¿Qué pasa con la información en los equipos?',
    a: 'Se realiza borrado seguro o destrucción física del soporte. El partner certificado emite certificado individual por dispositivo con número de serie, método y fecha.',
  },
  {
    q: '¿El certificado es válido para licitaciones y auditorías?',
    a: 'Sí. Los certificados son emitidos por gestores autorizados y son válidos para auditorías internas, informes ESG, licitaciones públicas y cumplimiento de la Ley REP.',
  },
  {
    q: '¿Cuánto tarda el proceso desde el retiro hasta el certificado?',
    a: 'El acta de recepción se emite el mismo día. El certificado de disposición final llega en máximo 5 días hábiles.',
  },
];
---

<BlueprintLayout
  title="Reciclaje Electrónico para Empresas en Chile | Retiro + Certificado | ElectroLoop"
  description="Retiro de equipos electrónicos en tus instalaciones, destrucción certificada de datos y certificado de disposición final. Cumplimiento Ley REP para empresas en la III y IV Región. Solicita cotización gratuita."
>

  <!-- HERO -->
  <section class="re-hero v2-section" id="inicio" data-section="Inicio" data-index="01">
    <nav class="re-breadcrumb v2-mono v2-mono--steel">
      <a href="/">INICIO</a>
      <span aria-hidden="true"> / </span>
      <span>RECICLAJE ELECTRÓNICO EMPRESAS</span>
    </nav>

    <p class="re-eyebrow v2-mono v2-mono--copper">[ SERVICIO B2B · MACROZONA NORTE CHILE ]</p>

    <h1 class="re-h1">
      <span class="re-h1-outline">RECICLAJE</span><br />
      <span class="re-h1-solid">ELECTRÓNICO</span><br />
      <span class="re-h1-thin">PARA EMPRESAS</span>
    </h1>

    <p class="re-lead">
      Retiro de equipos en tus instalaciones, destrucción certificada de datos y
      certificado de disposición final. Un solo punto de contacto, documentación
      auditable en cada paso.
    </p>

    <div class="re-ctas">
      <a href="/#contacto" class="re-cta-primary v2-mono">
        SOLICITAR RETIRO <span aria-hidden="true">→</span>
        <i class="v2-drawline" aria-hidden="true"></i>
      </a>
      <a href="#como-funciona" class="re-cta-secondary v2-mono">
        VER CÓMO FUNCIONA <span aria-hidden="true">↓</span>
      </a>
    </div>

    <p class="re-honest v2-mono v2-mono--steel">
      [ INICIO OPERATIVO AGOSTO 2026 · SERVICIO VÍA PARTNERS CERTIFICADOS ]
    </p>
  </section>

  <!-- QUÉ RECICLAMOS -->
  <section class="re-section v2-light" id="equipos" data-section="Equipos" data-index="02">
    <header class="v2-sechead">
      <span class="sh-idx">02</span>
      <h2 class="sh-name">¿Qué Equipos Retiramos?</h2>
      <i class="v2-drawline" aria-hidden="true"></i>
    </header>

    <p class="re-intro">
      Cualquier aparato eléctrico o electrónico en desuso, sin importar su estado:
    </p>

    <ul class="re-equipo-grid" role="list">
      {equipos.map((e) => (
        <li class="re-equipo-cell v2-mono">
          <span class="re-tick" aria-hidden="true">—</span>
          {e}
        </li>
      ))}
    </ul>

    <div class="re-nota v2-mono v2-mono--steel">
      [ ¿NO VES TU EQUIPO? IGUAL LO RETIRAMOS. CONTÁCTANOS Y TE CONFIRMAMOS EN 24H ]
    </div>
  </section>

  <!-- CÓMO FUNCIONA -->
  <section class="re-section" id="como-funciona" data-section="Proceso" data-index="03">
    <header class="v2-sechead">
      <span class="sh-idx">03</span>
      <h2 class="sh-name">Cómo Funciona</h2>
      <i class="v2-drawline" aria-hidden="true"></i>
    </header>

    <ol class="re-steps" role="list">
      {pasos.map((p, i) => (
        <li class={`re-step${i === pasos.length - 1 ? ' re-step--final' : ''}`}>
          <span class="re-step-n v2-mono">{p.n}</span>
          <div class="re-step-body">
            <h3 class="re-step-title">{p.title}</h3>
            <p class="re-step-desc">{p.desc}</p>
            <span class="re-step-seal v2-mono v2-mono--copper">{p.seal}</span>
          </div>
          {i < pasos.length - 1 && <span class="re-step-line" aria-hidden="true"></span>}
        </li>
      ))}
    </ol>
  </section>

  <!-- POR QUÉ IMPORTA -->
  <section class="re-section v2-light" id="por-que" data-section="Riesgos" data-index="04">
    <header class="v2-sechead">
      <span class="sh-idx">04</span>
      <h2 class="sh-name">Por Qué No Puedes Tirar los Equipos a la Basura</h2>
      <i class="v2-drawline" aria-hidden="true"></i>
    </header>

    <p class="re-intro">
      Los RAEE contienen <strong>plomo, mercurio, cadmio y arsénico</strong>. Desecharlos
      en basura común es ilegal bajo la Ley REP y genera:
    </p>

    <ul class="re-riesgo-grid" role="list">
      {riesgos.map((r) => (
        <li class="re-riesgo-cell">
          <span class="re-riesgo-code v2-mono v2-mono--copper">[ {r.code} ]</span>
          <h3 class="re-riesgo-title">{r.title}</h3>
          <p class="re-riesgo-desc">{r.desc}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- SECTORES -->
  <section class="re-section" id="sectores" data-section="Sectores" data-index="05">
    <header class="v2-sechead">
      <span class="sh-idx">05</span>
      <h2 class="sh-name">Sectores que Atendemos</h2>
      <i class="v2-drawline" aria-hidden="true"></i>
    </header>

    <p class="re-intro re-intro--light">Empresas de todos los tamaños y rubros en la macrozona norte de Chile:</p>

    <ul class="re-sectores" role="list">
      {sectores.map((s) => (
        <li class="re-sector-tag v2-mono">{s}</li>
      ))}
    </ul>
  </section>

  <!-- CTA -->
  <section class="re-section re-cta-section" id="contacto-cta" data-section="Cotizar" data-index="06">
    <p class="re-cta-eyebrow v2-mono v2-mono--copper">[ ¿TIENES EQUIPOS EN DESUSO? ]</p>
    <h2 class="re-cta-title">
      Cuéntanos cuántos equipos tienes.<br />
      Te cotizamos el retiro.
    </h2>
    <a href="/#contacto" class="re-cta-primary v2-mono" style="font-size:0.85rem; padding:18px 0;">
      SOLICITAR COTIZACIÓN GRATUITA <span aria-hidden="true">→</span>
      <i class="v2-drawline" aria-hidden="true"></i>
    </a>
  </section>

  <!-- FAQ -->
  <section class="re-section v2-light" id="faq" data-section="FAQ" data-index="07">
    <header class="v2-sechead">
      <span class="sh-idx">07</span>
      <h2 class="sh-name">Preguntas Frecuentes</h2>
      <i class="v2-drawline" aria-hidden="true"></i>
    </header>

    <dl class="re-faq">
      {faqs.map((f) => (
        <div class="re-faq-item">
          <dt class="re-faq-q">{f.q}</dt>
          <dd class="re-faq-a">{f.a}</dd>
        </div>
      ))}
    </dl>
  </section>

  <FooterV2 />

  <!-- Schema.org: Service -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Reciclaje de Equipos Electrónicos para Empresas en Chile',
    description: 'Retiro de RAEE en instalaciones, destrucción certificada de datos y certificado de disposición final. Cumplimiento Ley REP para empresas en III y IV Región de Chile.',
    provider: {
      '@type': 'Organization',
      name: 'ElectroLoop SpA',
      url: 'https://electroloop.cl',
    },
    areaServed: [
      { '@type': 'State', name: 'Región de Atacama', containedInPlace: { '@type': 'Country', name: 'Chile' } },
      { '@type': 'State', name: 'Región de Coquimbo', containedInPlace: { '@type': 'Country', name: 'Chile' } },
    ],
    serviceType: 'Reciclaje Electrónico Empresas RAEE',
    url: 'https://electroloop.cl/reciclaje-electronico-empresas-chile/',
    offers: {
      '@type': 'Offer',
      description: 'Cotización gratuita sin compromiso para retiro de equipos electrónicos',
      price: '0',
      priceCurrency: 'CLP',
    },
  })} />

  <!-- Schema.org: FAQPage (rich snippets en Google) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.a,
      },
    })),
  })} />

</BlueprintLayout>

<style>
  /* ───────────── TOKENS ───────────── */
  .re-hero,
  .re-section {
    padding: clamp(64px, 10vh, 120px) var(--margin-edge) clamp(64px, 10vh, 120px) var(--margin-bind);
  }

  /* ───────────── HERO ───────────── */
  .re-hero {
    background: var(--abyssal);
    color: var(--ceramic);
    min-height: 85vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .re-breadcrumb {
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    margin-bottom: clamp(32px, 5vh, 56px);
  }
  .re-breadcrumb a {
    color: var(--steel);
    text-decoration: none;
  }
  .re-breadcrumb a:hover { color: var(--copper); }

  .re-eyebrow {
    font-size: 0.65rem;
    margin-bottom: 24px;
  }

  .re-h1 {
    font-family: var(--font-display);
    line-height: 0.92;
    margin: 0 0 clamp(28px, 4vh, 48px);
  }
  .re-h1-outline {
    font-size: clamp(3.5rem, 11vw, 10rem);
    font-weight: 800;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--ceramic);
    display: block;
    letter-spacing: -0.02em;
  }
  .re-h1-solid {
    font-size: clamp(3.5rem, 11vw, 10rem);
    font-weight: 800;
    color: var(--copper);
    display: block;
    letter-spacing: -0.02em;
  }
  .re-h1-thin {
    font-size: clamp(1.6rem, 4.5vw, 4.5rem);
    font-weight: 300;
    color: var(--ceramic);
    display: block;
    letter-spacing: 0.08em;
    margin-top: 8px;
  }

  .re-lead {
    font-size: clamp(1rem, 1.8vw, 1.35rem);
    font-weight: 300;
    line-height: 1.65;
    max-width: 52ch;
    color: rgba(244, 244, 244, 0.85);
    margin: 0 0 clamp(32px, 5vh, 48px);
  }

  .re-ctas {
    display: flex;
    gap: 32px;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: clamp(32px, 5vh, 48px);
  }

  .re-cta-primary {
    position: relative;
    text-decoration: none;
    color: var(--ceramic);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    padding: 16px 0;
  }
  .re-cta-primary:hover { color: var(--copper); }
  .re-cta-primary .v2-drawline { bottom: 6px; left: 0; right: 0; position: absolute; }

  .re-cta-secondary {
    text-decoration: none;
    color: var(--steel);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    transition: color 0.3s;
  }
  .re-cta-secondary:hover { color: var(--ceramic); }

  .re-honest {
    font-size: 0.58rem;
    margin: 0;
  }

  /* ───────────── SECCIONES GENERALES ───────────── */
  .re-section { position: relative; }

  .re-intro {
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    font-weight: 300;
    line-height: 1.7;
    color: var(--abyssal);
    max-width: 64ch;
    margin: 0 0 clamp(36px, 5vh, 56px);
  }
  .re-intro strong { font-weight: 800; }
  .re-intro--light { color: var(--ceramic); }

  .re-nota {
    font-size: 0.58rem;
    margin-top: clamp(28px, 4vh, 48px);
  }

  /* ───────────── EQUIPOS ───────────── */
  .re-equipo-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0;
    border-top: 1px solid rgba(11, 27, 50, 0.18);
    border-left: 1px solid rgba(11, 27, 50, 0.18);
  }

  .re-equipo-cell {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 18px 20px;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--abyssal);
    border-right: 1px solid rgba(11, 27, 50, 0.18);
    border-bottom: 1px solid rgba(11, 27, 50, 0.18);
    transition: background 0.3s;
  }
  .re-equipo-cell:hover { background: rgba(143, 87, 34, 0.06); }

  .re-tick {
    color: var(--copper-ink, var(--copper));
    font-weight: 700;
    flex-shrink: 0;
  }

  /* ───────────── PASOS ───────────── */
  .re-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .re-step {
    position: relative;
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 0 24px;
    padding: clamp(28px, 4vh, 48px) 0;
    border-bottom: 1px solid rgba(142, 146, 151, 0.2);
  }
  .re-step--final { border-bottom: none; }

  .re-step-n {
    font-size: 3rem;
    font-weight: 800;
    line-height: 1;
    color: rgba(184, 115, 51, 0.25);
    align-self: start;
    padding-top: 4px;
  }

  .re-step-body { padding-right: var(--margin-edge); }

  .re-step-title {
    font-size: clamp(1.2rem, 2vw, 1.7rem);
    font-weight: 700;
    color: var(--ceramic);
    margin: 0 0 12px;
    letter-spacing: -0.01em;
  }

  .re-step-desc {
    font-size: clamp(0.9rem, 1.3vw, 1.05rem);
    font-weight: 300;
    color: var(--steel);
    line-height: 1.7;
    margin: 0 0 16px;
    max-width: 60ch;
  }

  .re-step-seal { font-size: 0.58rem; }

  /* ───────────── RIESGOS ───────────── */
  .re-riesgo-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1px;
    background: rgba(11, 27, 50, 0.15);
    border: 1px solid rgba(11, 27, 50, 0.15);
  }

  .re-riesgo-cell {
    background: var(--ceramic);
    padding: clamp(24px, 3vw, 36px);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .re-riesgo-code { font-size: 0.6rem; }

  .re-riesgo-title {
    font-size: 1rem;
    font-weight: 800;
    color: var(--abyssal);
    margin: 0;
    letter-spacing: 0.01em;
  }

  .re-riesgo-desc {
    font-size: 0.85rem;
    font-weight: 300;
    color: var(--steel-ink, #5d6267);
    line-height: 1.65;
    margin: 0;
  }

  /* ───────────── SECTORES ───────────── */
  .re-sectores {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .re-sector-tag {
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    color: var(--steel);
    padding: 10px 20px;
    border: 1px solid rgba(142, 146, 151, 0.3);
    transition: border-color 0.3s, color 0.3s;
  }
  .re-sector-tag:hover { border-color: var(--copper); color: var(--copper); }

  /* ───────────── CTA SECTION ───────────── */
  .re-cta-section {
    background: var(--abyssal);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(20px, 3vh, 32px);
  }

  .re-cta-eyebrow { font-size: 0.62rem; margin: 0; }

  .re-cta-title {
    font-size: clamp(1.8rem, 4vw, 3.5rem);
    font-weight: 300;
    color: var(--ceramic);
    line-height: 1.25;
    margin: 0;
    letter-spacing: -0.01em;
  }

  /* ───────────── FAQ ───────────── */
  .re-faq {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid rgba(11, 27, 50, 0.18);
  }

  .re-faq-item {
    padding: clamp(24px, 3.5vh, 40px) 0;
    border-bottom: 1px solid rgba(11, 27, 50, 0.18);
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 24px;
  }

  .re-faq-q {
    font-size: clamp(0.9rem, 1.3vw, 1.1rem);
    font-weight: 700;
    color: var(--abyssal);
    margin: 0;
    line-height: 1.4;
  }

  .re-faq-a {
    font-size: clamp(0.85rem, 1.1vw, 1rem);
    font-weight: 300;
    color: var(--steel-ink, #5d6267);
    line-height: 1.75;
    margin: 0;
  }

  /* ───────────── RESPONSIVE ───────────── */
  @media (max-width: 860px) {
    .re-faq-item { grid-template-columns: 1fr; gap: 12px; }
    .re-step { grid-template-columns: 56px 1fr; }
    .re-step-body { padding-right: 0; }
  }

  @media (max-width: 600px) {
    .re-equipo-grid { grid-template-columns: 1fr 1fr; }
    .re-riesgo-grid { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .re-equipo-cell,
    .re-sector-tag { transition: none; }
  }
</style>
