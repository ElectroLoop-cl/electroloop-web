      "@type": "Organization",
      "name": "ElectroLoop SpA",
      "logo": {
        "@type": "ImageObject",
        "url": "https://electroloop.cl/favicon.png"
      }
    },
    "datePublished": "2026-09-30",
    "dateModified": "2026-09-30",
    "mainEntityOfPage": "https://electroloop.cl/noticias/sistemas-de-gestion-raee-traee-wee-chile/",
    "inLanguage": "es-CL",
    "articleSection": "Mercado REP",
    "keywords": "sistema de gestión RAEE, TRAEE, Wee Chile, sistema colectivo Ley REP, GRANSIC RAEE, DS 22 aparatos eléctricos electrónicos, productores AEE Chile"
  })} />

</div>
</Layout>
