    "author": { "@type": "Organization", "name": "ElectroLoop SpA", "url": "https://electroloop.cl" },
    "publisher": {
      "@type": "Organization",
      "name": "ElectroLoop SpA",
      "logo": { "@type": "ImageObject", "url": "https://electroloop.cl/favicon.png" }
    },
    "datePublished": "2026-10-09",
    "dateModified": "2026-10-09",
    "mainEntityOfPage": "https://electroloop.cl/noticias/equipos-danados-inundacion-que-hacer/",
    "inLanguage": "es-CL",
    "articleSection": "Emergencia",
    "keywords": "equipos dañados inundación, aluvión Las Condes equipos, computador mojado qué hacer, seguro equipos dañados, retiro equipos siniestrados Santiago, destrucción de datos discos mojados"
  })} />

</div>
</Layout>
