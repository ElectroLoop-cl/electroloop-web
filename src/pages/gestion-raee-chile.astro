  .gr-faq-q { font-size: clamp(0.9rem, 1.3vw, 1.1rem); font-weight: 700; color: var(--abyssal); margin: 0; line-height: 1.4; }
  .gr-faq-a { font-size: clamp(0.85rem, 1.1vw, 1rem); font-weight: 300; color: var(--steel-ink, #5d6267); line-height: 1.75; margin: 0; }

  /* RESPONSIVE */
