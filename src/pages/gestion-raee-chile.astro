  .gr-dif-cell { background: var(--ceramic); padding: clamp(24px, 3vw, 36px); display: flex; flex-direction: column; gap: 10px; }
  .gr-dif-tag { font-size: 0.6rem; }
  .gr-dif-title { font-size: 1rem; font-weight: 800; color: var(--abyssal); margin: 0; }
