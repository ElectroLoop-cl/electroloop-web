---
import BlueprintLayout from '../layouts/BlueprintLayout.astro';
import FooterV2 from '../components/v2/FooterV2.astro';
import FondoParticulas from '../components/v2/FondoParticulas.astro';
import AnimacionesEntrada from '../components/v2/AnimacionesEntrada.astro';
import ConoceElectroLoop from '../components/v2/ConoceElectroLoop.astro';

const obligaciones = [
  { num: '01', title: 'Inscribirse como productor', desc: 'Registro en el sistema del Ministerio del Medio Ambiente antes de comercializar productos en Chile.' },
  { num: '02', title: 'Cumplir metas anuales de recolección', desc: 'El DS 8/2021 fija metas porcentuales crecientes. En 2026 son significativamente mayores que en años anteriores.' },
  { num: '03', title: 'Contratar gestores RAEE autorizados', desc: 'Los RAEE recolectados deben entregarse exclusivamente a gestores autorizados por la SMA.' },
  { num: '04', title: 'Reportar anualmente al Ministerio', desc: 'Informe anual acreditando cumplimiento de metas, con certificados emitidos por el gestor.' },
  { num: '05', title: 'Financiar el sistema de gestión', desc: 'El productor financia recolección y tratamiento, ya sea individualmente o vía un SIG colectivo.' },
];

const categorias = [
  { tag: 'CAT. 1 — AIT', name: 'Aparatos de intercambio de temperatura', items: ['Refrigeradores', 'Aires acondicionados', 'Bombas de calor'] },
  { tag: 'CAT. 2 — PFV', name: 'Paneles fotovoltaicos', items: ['Módulos solares al fin de su vida útil', 'Crítico en el norte minero'] },
  { tag: 'CAT. 3 — AEE', name: 'Resto de aparatos eléctricos y electrónicos', items: ['Computadores y smartphones', 'Electrodomésticos', 'Herramientas eléctricas', 'Luminarias'] },
];

const sanciones = [
  { code: 'ECO', title: 'Multa hasta 10.000 UTA', desc: 'Equivalente a más de $700 millones de pesos chilenos.' },
  { code: 'OPS', title: 'Clausura temporal', desc: 'Cierre de instalaciones hasta regularización.' },
  { code: 'LEG', title: 'Revocación de permisos', desc: 'Pérdida de permisos de operación vigentes.' },
  { code: 'REP', title: 'Daño reputacional', desc: 'Publicación en Registro de Sanciones. Impacto directo en licitaciones y ESG.' },
];

const pasos = [
  { n: '01', title: 'Diagnóstico inicial', desc: 'Identifica qué productos están sujetos a REP y en qué volúmenes los introduces al mercado chileno.', seal: '[ SIN COSTO ADICIONAL ]' },
  { n: '02', title: 'Inscripción como productor', desc: 'Registro ante el Ministerio del Medio Ambiente en el sistema online habilitado.', seal: '[ OBLIGATORIO ANTES DE COMERCIALIZAR ]' },
  { n: '03', title: 'Seleccionar gestor integrador', desc: 'Trabaja con ElectroLoop: un solo punto de contacto que coordina todo el proceso con partners certificados.', seal: '[ VÍA PARTNERS CERTIFICADOS ]' },
  { n: '04', title: 'Implementar recolección', desc: 'Coordinamos retiro en tus instalaciones. Acta de recepción firmada el mismo día.', seal: '[ TRAZABILIDAD DESDE EL PRIMER KILO ]' },
  { n: '05', title: 'Reportar al Ministerio', desc: 'Con los certificados que emitimos preparas tu informe anual. Te asistimos en todo el proceso.', seal: '[ CERTIFICADO EN 5 DÍAS HÁBILES ]' },
];

const faqs = [
  { q: '¿Cuándo entró en vigor la Ley REP para RAEE?', a: 'El DS 8/2021 para aparatos eléctricos y electrónicos entró en vigor en 2023 para los primeros productores obligados. Las metas se incrementan año a año hasta 2030.' },
  { q: '¿Qué pasa si soy una PYME pequeña?', a: 'La Ley REP aplica según el volumen que introduces al mercado. Las empresas pequeñas tienen metas menores, pero la obligación existe si superas los umbrales del reglamento.' },
  { q: '¿Puedo cumplir de forma individual o debo unirme a un SIG?', a: 'Ambas opciones son válidas: contrato directo con un gestor integrador como ElectroLoop, o sumarte a un Sistema Integrado de Gestión (SIG) colectivo.' },
  { q: '¿Cuánto cuesta cumplir con la Ley REP?', a: 'Depende del volumen y tipo de equipos. Ofrecemos cotizaciones sin costo. El cumplimiento es significativamente más barato que el riesgo de una sanción.' },
  { q: '¿ElectroLoop entrega los documentos para el reporte anual?', a: 'Sí. Emitimos certificados y reportes necesarios: toneladas valorizadas, tipo de material, destino final. Válidos para auditoría REP e informes ESG.' },
];
---

<BlueprintLayout
  preloader={false}
  title="Ley REP Chile Empresas: Guía Completa de Cumplimiento RAEE | ElectroLoop"
  description="Todo lo que tu empresa necesita saber sobre la Ley REP Chile (N° 20.920). Obligaciones, plazos, multas y cómo cumplir con la gestión de residuos electrónicos."
>

  <!-- HERO -->
  <section class="lr-hero v2-section" id="inicio" data-section="Inicio" data-index="01">
    <AnimacionesEntrada />
    <FondoParticulas />
    <nav class="lr-breadcrumb v2-mono v2-mono--steel">
      <a href="/">INICIO</a><span aria-hidden="true"> / </span><span>LEY REP CHILE EMPRESAS</span>
    </nav>
    <p class="lr-eyebrow v2-mono v2-mono--copper">[ GUÍA COMPLETA 2026 · LEY N° 20.920 ]</p>
    <h1 class="lr-h1">
      <span class="lr-h1-outline">GUÍA</span><br />
      <span class="lr-h1-solid">LEY REP</span><br />
      <span class="lr-h1-thin">PARA EMPRESAS</span>
    </h1>
    <p class="lr-lead">
      Obligaciones, plazos, multas y cómo cumplir con la gestión de residuos
      electrónicos bajo la Ley N° 20.920 y el DS 8/2021.
    </p>
    <nav class="lr-indice" aria-label="Índice de contenidos">
      <span class="lr-indice-label v2-mono v2-mono--steel">[ EN ESTA GUÍA ]</span>
      <ol class="lr-indice-list v2-mono">
        <li><a href="#que-es">Qué es la Ley REP</a></li>
        <li><a href="#quienes">A qué empresas aplica</a></li>
        <li><a href="#obligaciones">Obligaciones concretas</a></li>
        <li><a href="#multas">Multas y sanciones</a></li>
        <li><a href="#como-cumplir">Cómo cumplir paso a paso</a></li>
        <li><a href="#faq">Preguntas frecuentes</a></li>
      </ol>
    </nav>
  </section>

  <!-- QUÉ ES -->
  <section class="lr-section v2-light" id="que-es" data-section="Qué es" data-index="02">
    <header class="v2-sechead">
      <span class="sh-idx">02</span>
      <h2 class="sh-name">¿Qué es la Ley REP Chile?</h2>
      <i class="v2-drawline" aria-hidden="true"></i>
    </header>
    <div class="lr-two-col">
      <div class="lr-col-main">
        <p class="lr-text">La <strong>Ley REP</strong> (Responsabilidad Extendida del Productor), Ley N° 20.920, establece que fabricantes e importadores de ciertos productos son responsables de gestionar correctamente esos productos al final de su vida útil.</p>
        <p class="lr-text">Si tu empresa fabrica, importa o vende aparatos eléctricos y electrónicos en Chile, la ley te hace responsable de que esos equipos sean reciclados o valorizados — no enviados al basural.</p>
        <p class="lr-text">Promulgada en <strong>2016</strong>, el reglamento para RAEE (DS 8/2021) entró en vigor en <strong>2023</strong> para los primeros productores obligados.</p>
      </div>
      <aside class="lr-col-aside">
        <span class="lr-aside-head v2-mono v2-mono--steel">[ DATO CLAVE ]</span>
        <p class="lr-aside-text">Chile es uno de los primeros países de Latinoamérica en implementar una Ley REP para residuos electrónicos, alineada con las mejores prácticas de la UE en economía circular.</p>
      </aside>
    </div>
  </section>

  <!-- QUIÉNES -->
  <section class="lr-section" id="quienes" data-section="A quiénes aplica" data-index="03">
    <header class="v2-sechead">
      <span class="sh-idx">03</span>
      <h2 class="sh-name">¿A Qué Empresas Aplica?</h2>
      <i class="v2-drawline" aria-hidden="true"></i>
    </header>
    <p class="lr-intro">La ley aplica a los <strong>productores</strong>: fabricantes, importadores, marcas propias y vendedores por comercio electrónico que introducen AEE al mercado chileno. Tres categorías reguladas:</p>
    <div class="lr-cat-grid">
      {categorias.map((c) => (
        <div class="lr-cat-card">
          <span class="lr-cat-tag v2-mono v2-mono--copper">{c.tag}</span>
          <h3 class="lr-cat-name">{c.name}</h3>
          <ul class="lr-cat-items v2-mono">{c.items.map(i => <li>{i}</li>)}</ul>
        </div>
      ))}
    </div>
    <p class="lr-nota v2-mono v2-mono--steel">[ AUNQUE NO SEAS PRODUCTOR: TIENES OBLIGACIÓN DE ENTREGAR TUS RAEE A UN GESTOR AUTORIZADO — NO DESECHARLOS EN BASURA COMÚN ]</p>
  </section>

  <!-- OBLIGACIONES -->
  <section class="lr-section v2-light" id="obligaciones" data-section="Obligaciones" data-index="04">
    <header class="v2-sechead">
      <span class="sh-idx">04</span>
      <h2 class="sh-name">Obligaciones Concretas para Productores</h2>
      <i class="v2-drawline" aria-hidden="true"></i>
    </header>
    <ol class="lr-oblig-list" role="list">
      {obligaciones.map((o) => (
        <li class="lr-oblig-item">
          <span class="lr-oblig-n v2-mono">{o.num}</span>
          <div>
            <h3 class="lr-oblig-title">{o.title}</h3>
            <p class="lr-oblig-desc">{o.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- MULTAS -->
  <section class="lr-section" id="multas" data-section="Multas" data-index="05">
    <header class="v2-sechead">
      <span class="sh-idx">05</span>
      <h2 class="sh-name">Multas y Sanciones</h2>
      <i class="v2-drawline" aria-hidden="true"></i>
    </header>
    <p class="lr-intro">El incumplimiento es fiscalizado por la <strong>Superintendencia del Medio Ambiente (SMA)</strong> con amplias facultades sancionatorias:</p>
    <ul class="lr-sancion-grid" role="list">
      {sanciones.map((s) => (
        <li class="lr-sancion-cell">
          <span class="lr-sancion-code v2-mono v2-mono--copper">[ {s.code} ]</span>
          <h3 class="lr-sancion-title">{s.title}</h3>
          <p class="lr-sancion-desc">{s.desc}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- CÓMO CUMPLIR -->
  <section class="lr-section v2-light" id="como-cumplir" data-section="Cómo cumplir" data-index="06">
    <header class="v2-sechead">
      <span class="sh-idx">06</span>
      <h2 class="sh-name">Cómo Cumplir Paso a Paso</h2>
      <i class="v2-drawline" aria-hidden="true"></i>
    </header>
    <ol class="lr-steps" role="list">
      {pasos.map((p, i) => (
        <li class={`lr-step${i === pasos.length - 1 ? ' lr-step--final' : ''}`}>
          <span class="lr-step-n v2-mono">{p.n}</span>
          <div class="lr-step-body">
            <h3 class="lr-step-title">{p.title}</h3>
            <p class="lr-step-desc">{p.desc}</p>
            <span class="lr-step-seal v2-mono v2-mono--copper">{p.seal}</span>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- CTA -->
  <section class="lr-section lr-cta-section" id="contacto-cta" data-section="Consultar" data-index="07">
    <p class="lr-cta-eyebrow v2-mono v2-mono--copper">[ ¿TU EMPRESA NECESITA CUMPLIR CON LA LEY REP? ]</p>
    <h2 class="lr-cta-title">
      Cuéntanos tu situación.<br />
      Te explicamos qué necesitas hacer.
    </h2>
    <a href="/#contacto" class="lr-cta-btn v2-mono">
      HABLAR CON UN ESPECIALISTA <span aria-hidden="true">→</span>
      <i class="v2-drawline" aria-hidden="true"></i>
    </a>
    <p class="lr-honest v2-mono v2-mono--steel">[ SERVICIO VÍA PARTNERS CERTIFICADOS ]</p>
  </section>

  <!-- FAQ -->
  <section class="lr-section v2-light" id="faq" data-section="FAQ" data-index="08">
    <header class="v2-sechead">
      <span class="sh-idx">08</span>
      <h2 class="sh-name">Preguntas Frecuentes — Ley REP</h2>
      <i class="v2-drawline" aria-hidden="true"></i>
    </header>
    <dl class="lr-faq">
      {faqs.map((f) => (
        <div class="lr-faq-item">
          <dt class="lr-faq-q">{f.q}</dt>
          <dd class="lr-faq-a">{f.a}</dd>
        </div>
      ))}
    </dl>
  </section>

  <ConoceElectroLoop />

  <FooterV2 />

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'Ley REP Chile Empresas: Guía Completa de Cumplimiento RAEE 2026',
    description: 'Obligaciones, plazos, multas y cómo cumplir con la gestión de residuos electrónicos bajo la Ley N° 20.920.',
    author: { '@type': 'Organization', name: 'ElectroLoop', url: 'https://electroloop.cl' },
    publisher: { '@type': 'Organization', name: 'ElectroLoop', logo: { '@type': 'ImageObject', url: 'https://electroloop.cl/favicon.png' } },
    datePublished: '2026-04-15',
    dateModified: '2026-06-17',
    mainEntityOfPage: 'https://electroloop.cl/ley-rep-chile-empresas',
    inLanguage: 'es-CL',
    about: { '@type': 'Thing', name: 'Ley REP Chile', description: 'Ley N° 20.920 de Responsabilidad Extendida del Productor' },
  })} />

</BlueprintLayout>

<style>
  .lr-hero,
  .lr-section {
    padding: clamp(64px, 10vh, 120px) var(--margin-edge) clamp(64px, 10vh, 120px) var(--margin-bind);
  }

  /* HERO */
  .lr-hero { background: var(--abyssal); color: var(--ceramic); min-height: 85vh; display: flex; flex-direction: column; justify-content: center; /* la barra superior es fija (~95px): el contenido parte bajo ella */ padding-top: max(clamp(88px, 14vh, 180px), 136px); }
  .lr-breadcrumb { font-size: 0.6rem; letter-spacing: 0.12em; margin-bottom: clamp(32px, 5vh, 56px); }
  .lr-breadcrumb a { color: var(--steel); text-decoration: none; }
  .lr-breadcrumb a:hover { color: var(--copper); }
  .lr-eyebrow { font-size: 0.65rem; margin-bottom: 24px; }
  .lr-h1 { font-family: var(--font-display); line-height: 0.92; margin: 0 0 clamp(28px, 4vh, 48px); }
  .lr-h1-outline { font-size: clamp(3.5rem, 11vw, 10rem); font-weight: 800; color: transparent; -webkit-text-stroke: 1.5px var(--ceramic); display: block; letter-spacing: -0.02em; }
  .lr-h1-solid { font-size: clamp(3.5rem, 11vw, 10rem); font-weight: 800; color: var(--copper); display: block; letter-spacing: -0.02em; }
  .lr-h1-thin { font-size: clamp(1.6rem, 4.5vw, 4.5rem); font-weight: 300; color: var(--ceramic); display: block; letter-spacing: 0.08em; margin-top: 8px; }
  .lr-lead { font-size: clamp(1rem, 1.8vw, 1.35rem); font-weight: 300; line-height: 1.65; max-width: 52ch; color: rgba(244, 244, 244, 0.85); margin: 0 0 clamp(28px, 4vh, 40px); }
  .lr-indice { display: flex; flex-direction: column; gap: 14px; }
  .lr-indice-label { font-size: 0.58rem; }
  .lr-indice-list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 24px; }
  .lr-indice-list li { font-size: 0.65rem; letter-spacing: 0.08em; }
  .lr-indice-list a { color: var(--steel); text-decoration: none; transition: color 0.3s; }
  .lr-indice-list a:hover { color: var(--copper); }

  /* SECTIONS */
  .lr-section { position: relative; }
  .lr-intro { font-size: clamp(1rem, 1.5vw, 1.2rem); font-weight: 300; line-height: 1.7; color: var(--ceramic); max-width: 64ch; margin: 0 0 clamp(36px, 5vh, 56px); }
  .lr-intro strong { font-weight: 800; }
  .lr-nota { font-size: 0.58rem; margin-top: clamp(28px, 4vh, 48px); }
  .lr-text { font-size: clamp(0.95rem, 1.4vw, 1.1rem); font-weight: 300; line-height: 1.75; color: var(--abyssal); margin: 0 0 1.2em; max-width: 64ch; }
  .lr-text strong { font-weight: 800; }

  /* TWO-COL */
  .lr-two-col { display: grid; grid-template-columns: 1fr 320px; gap: 48px; align-items: start; }
  .lr-col-aside { border-left: 1px solid rgba(11, 27, 50, 0.2); padding-left: 32px; display: flex; flex-direction: column; gap: 12px; }
  .lr-aside-head { font-size: 0.58rem; }
  .lr-aside-text { font-size: 0.9rem; font-weight: 300; line-height: 1.7; color: var(--steel-ink, #5d6267); margin: 0; }

  /* CATEGORÍAS */
  .lr-cat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1px; background: rgba(11,27,50,0.12); border: 1px solid rgba(11,27,50,0.12); }
  .lr-cat-card { background: var(--abyssal); padding: clamp(24px, 3vw, 36px); display: flex; flex-direction: column; gap: 10px; }
  .lr-cat-tag { font-size: 0.6rem; }
  .lr-cat-name { font-size: 1rem; font-weight: 700; color: var(--ceramic); margin: 0; }
  .lr-cat-items { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4px; }
  .lr-cat-items li { font-size: 0.65rem; letter-spacing: 0.06em; color: var(--steel); }

  /* OBLIGACIONES */
  .lr-oblig-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgba(11,27,50,0.18); }
  .lr-oblig-item { display: grid; grid-template-columns: 64px 1fr; gap: 0 24px; padding: clamp(24px, 3.5vh, 40px) 0; border-bottom: 1px solid rgba(11,27,50,0.18); align-items: start; }
  .lr-oblig-n { font-size: 2.5rem; font-weight: 800; color: rgba(184, 115, 51, 0.22); line-height: 1; padding-top: 4px; }
  .lr-oblig-title { font-size: clamp(1rem, 1.6vw, 1.35rem); font-weight: 700; color: var(--abyssal); margin: 0 0 8px; }
  .lr-oblig-desc { font-size: clamp(0.85rem, 1.1vw, 1rem); font-weight: 300; color: var(--steel-ink, #5d6267); line-height: 1.7; margin: 0; max-width: 58ch; }

  /* SANCIONES */
  .lr-sancion-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1px; background: rgba(11,27,50,0.15); border: 1px solid rgba(11,27,50,0.15); }
  .lr-sancion-cell { background: var(--ceramic); padding: clamp(24px, 3vw, 36px); display: flex; flex-direction: column; gap: 10px; }
  .lr-sancion-code { font-size: 0.6rem; }
  .lr-sancion-title { font-size: 1rem; font-weight: 800; color: var(--abyssal); margin: 0; }
  .lr-sancion-desc { font-size: 0.85rem; font-weight: 300; color: var(--steel-ink, #5d6267); line-height: 1.65; margin: 0; }

  /* PASOS */
  .lr-steps { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgba(11,27,50,0.18); }
  .lr-step { display: grid; grid-template-columns: 80px 1fr; gap: 0 24px; padding: clamp(28px, 4vh, 48px) 0; border-bottom: 1px solid rgba(11,27,50,0.18); }
  .lr-step--final { border-bottom: none; }
  .lr-step-n { font-size: 3rem; font-weight: 800; color: rgba(184,115,51,0.25); line-height: 1; align-self: start; padding-top: 4px; }
  .lr-step-body { padding-right: var(--margin-edge); }
  .lr-step-title { font-size: clamp(1.1rem, 1.8vw, 1.5rem); font-weight: 700; color: var(--abyssal); margin: 0 0 10px; }
  .lr-step-desc { font-size: clamp(0.9rem, 1.2vw, 1rem); font-weight: 300; color: var(--steel-ink, #5d6267); line-height: 1.7; margin: 0 0 14px; max-width: 60ch; }
  .lr-step-seal { font-size: 0.58rem; }

  /* CTA */
  .lr-cta-section { background: var(--abyssal); display: flex; flex-direction: column; align-items: flex-start; gap: clamp(20px, 3vh, 32px); }
  .lr-cta-eyebrow { font-size: 0.62rem; margin: 0; }
  .lr-cta-title { font-size: clamp(1.8rem, 4vw, 3.5rem); font-weight: 300; color: var(--ceramic); line-height: 1.25; margin: 0; letter-spacing: -0.01em; }
  .lr-cta-btn { position: relative; text-decoration: none; color: var(--ceramic); font-weight: 700; font-size: 0.8rem; letter-spacing: 0.14em; padding: 16px 0; }
  .lr-cta-btn:hover { color: var(--copper); }
  .lr-cta-btn .v2-drawline { bottom: 6px; left: 0; right: 0; position: absolute; }
  .lr-honest { font-size: 0.58rem; margin: 0; }

  /* FAQ */
  .lr-faq { display: flex; flex-direction: column; gap: 0; border-top: 1px solid rgba(11,27,50,0.18); }
  .lr-faq-item { padding: clamp(24px, 3.5vh, 40px) 0; border-bottom: 1px solid rgba(11,27,50,0.18); display: grid; grid-template-columns: 1fr 1.4fr; gap: 24px; }
  .lr-faq-q { font-size: clamp(0.9rem, 1.3vw, 1.1rem); font-weight: 700; color: var(--abyssal); margin: 0; line-height: 1.4; }
  .lr-faq-a { font-size: clamp(0.85rem, 1.1vw, 1rem); font-weight: 300; color: var(--steel-ink, #5d6267); line-height: 1.75; margin: 0; }

  /* RESPONSIVE */
  @media (max-width: 860px) {
    .lr-two-col { grid-template-columns: 1fr; }
    .lr-col-aside { border-left: none; border-top: 1px solid rgba(11,27,50,0.15); padding-left: 0; padding-top: 24px; }
    .lr-faq-item { grid-template-columns: 1fr; gap: 12px; }
    .lr-step { grid-template-columns: 56px 1fr; }
    .lr-step-body { padding-right: 0; }
  }
  @media (max-width: 600px) {
    .lr-sancion-grid, .lr-cat-grid { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .lr-indice-list a, .lr-breadcrumb a, .lr-cta-btn { transition: none; }
  }

  /* Fondo de partículas: el contenido del hero va por encima del canvas */
  .lr-hero { overflow: hidden; }
  .lr-hero > :global(:not(canvas)) { position: relative; z-index: 1; }
</style>

