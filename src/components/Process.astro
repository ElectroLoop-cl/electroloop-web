---
// Process.astro — 5-step timeline with modern dark glassmorphic design
---

<section id="proceso" class="relative w-full py-32 overflow-hidden bg-gradient-to-b from-slate-900 via-slate-800 to-slate-900">
  <!-- Background accent elements -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-32 right-0 w-96 h-96 bg-amber-500/20 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 left-1/4 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl"></div>
  </div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Header -->
    <div class="text-center mb-20">
      <div class="inline-block mb-4">
        <span class="inline-block text-xs font-bold tracking-widest uppercase px-4 py-2 rounded-full" style="background: rgba(251, 146, 60, 0.1); color: #FB923C;">
          Metodología
        </span>
      </div>
      <h2 class="text-5xl md:text-6xl font-bold text-white mb-6 leading-tight">
        Cómo <span class="text-amber-500">Funciona</span>
      </h2>
      <p class="text-lg text-slate-400 max-w-3xl mx-auto">
        Un proceso transparente y certificado de principio a fin
      </p>
    </div>

    <!-- Desktop: Horizontal Timeline -->
    <div class="hidden lg:block relative">
      <!-- Timeline connecting line -->
      <div class="absolute top-20 left-0 right-0 h-px px-20" aria-hidden="true">
        <div class="relative h-full bg-gradient-to-r from-transparent via-amber-500/30 to-transparent"></div>
      </div>

      <!-- Steps row -->
      <div class="grid grid-cols-5 gap-8 relative">

        <!-- Step 1 -->
        <div class="flex flex-col items-center text-center">
          <div class="relative z-10 w-14 h-14 rounded-full flex items-center justify-center mb-8 flex-shrink-0 bg-gradient-to-br from-amber-500/30 to-orange-500/20 border border-amber-500/50 shadow-lg shadow-amber-500/20 group-hover:shadow-xl group-hover:shadow-amber-500/30 transition-all duration-300">
            <svg class="w-7 h-7 text-amber-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10l2 2h8l2-2zM13 16l1.5-3H18l2 2v1h-7z" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div class="text-sm font-bold text-amber-400 mb-2">01</div>
          <h3 class="text-lg font-bold text-white mb-2">Recolección</h3>
          <p class="text-sm text-slate-400 leading-relaxed">
            Coordinamos el retiro con partners logísticos certificados, manifiestos de transporte y confirmación en 48 horas.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="flex flex-col items-center text-center">
          <div class="relative z-10 w-14 h-14 rounded-full flex items-center justify-center mb-8 flex-shrink-0 bg-gradient-to-br from-amber-500/30 to-orange-500/20 border border-amber-500/50 shadow-lg shadow-amber-500/20 group-hover:shadow-xl group-hover:shadow-amber-500/30 transition-all duration-300">
            <svg class="w-7 h-7 text-amber-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div class="text-sm font-bold text-amber-400 mb-2">02</div>
          <h3 class="text-lg font-bold text-white mb-2">Clasificación</h3>
          <p class="text-sm text-slate-400 leading-relaxed">
            Recepción, pesaje y categorización de equipos según tipo, composición y estado con partners certificados.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="flex flex-col items-center text-center">
          <div class="relative z-10 w-14 h-14 rounded-full flex items-center justify-center mb-8 flex-shrink-0 bg-gradient-to-br from-amber-500/30 to-orange-500/20 border border-amber-500/50 shadow-lg shadow-amber-500/20 group-hover:shadow-xl group-hover:shadow-amber-500/30 transition-all duration-300">
            <svg class="w-7 h-7 text-amber-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path d="M20.618 5.984A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div class="text-sm font-bold text-amber-400 mb-2">03</div>
          <h3 class="text-lg font-bold text-white mb-2">Pre-tratamiento</h3>
          <p class="text-sm text-slate-400 leading-relaxed">
            Descontaminación, extracción segura de componentes peligrosos con protocolos certificados.
          </p>
        </div>

        <!-- Step 4 -->
        <div class="flex flex-col items-center text-center">
          <div class="relative z-10 w-14 h-14 rounded-full flex items-center justify-center mb-8 flex-shrink-0 bg-gradient-to-br from-amber-500/30 to-orange-500/20 border border-amber-500/50 shadow-lg shadow-amber-500/20 group-hover:shadow-xl group-hover:shadow-amber-500/30 transition-all duration-300">
            <svg class="w-7 h-7 text-amber-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div class="text-sm font-bold text-amber-400 mb-2">04</div>
          <h3 class="text-lg font-bold text-white mb-2">Valorización</h3>
          <p class="text-sm text-slate-400 leading-relaxed">
            Separación y refinación de metales preciosos. Derivación a recicladores especializados según material.
          </p>
        </div>

        <!-- Step 5 -->
        <div class="flex flex-col items-center text-center">
          <div class="relative z-10 w-14 h-14 rounded-full flex items-center justify-center mb-8 flex-shrink-0 bg-gradient-to-br from-amber-500/30 to-orange-500/20 border border-amber-500/50 shadow-lg shadow-amber-500/20 group-hover:shadow-xl group-hover:shadow-amber-500/30 transition-all duration-300">
            <svg class="w-7 h-7 text-amber-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div class="text-sm font-bold text-amber-400 mb-2">05</div>
          <h3 class="text-lg font-bold text-white mb-2">Certificación</h3>
          <p class="text-sm text-slate-400 leading-relaxed">
            Emisión de certificados de disposición final y reportes auditables para cumplimiento REP.
          </p>
        </div>

      </div>
    </div>

    <!-- Mobile: Vertical Timeline -->
    <div class="lg:hidden flex flex-col gap-0">

      {[
        {
          num: '01',
          title: 'Recolección',
          desc: 'Coordinamos el retiro con partners logísticos certificados, manifiestos de transporte y confirmación en 48 horas.',
          icon: `<path d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z" stroke-linecap="round" stroke-linejoin="round"/><path d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10l2 2h8l2-2zM13 16l1.5-3H18l2 2v1h-7z" stroke-linecap="round" stroke-linejoin="round"/>`
        },
        {
          num: '02',
          title: 'Clasificación',
          desc: 'Recepción, pesaje y categorización de equipos según tipo, composición y estado con partners certificados.',
          icon: `<path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke-linecap="round" stroke-linejoin="round"/>`
        },
        {
          num: '03',
          title: 'Pre-tratamiento',
          desc: 'Descontaminación, extracción segura de componentes peligrosos con protocolos certificados.',
          icon: `<path d="M20.618 5.984A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" stroke-linecap="round" stroke-linejoin="round"/>`
        },
        {
          num: '04',
          title: 'Valorización',
          desc: 'Separación y refinación de metales preciosos. Derivación a recicladores especializados según material.',
          icon: `<path d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" stroke-linecap="round" stroke-linejoin="round"/>`
        },
        {
          num: '05',
          title: 'Certificación',
          desc: 'Emisión de certificados de disposición final y reportes auditables para cumplimiento REP.',
          icon: `<path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" stroke-linecap="round" stroke-linejoin="round"/>`
        },
      ].map((step, i) => (
        <div class="flex gap-5 pb-8 relative">
          <!-- Vertical line -->
          {i < 4 && (
            <div
              class="absolute left-7 top-14 bottom-0 w-px bg-gradient-to-b from-amber-500/40 to-amber-500/10"
              aria-hidden="true"
            ></div>
          )}
          <!-- Circle -->
          <div class="relative z-10 w-12 h-12 rounded-full flex items-center justify-center flex-shrink-0 bg-gradient-to-br from-amber-500/30 to-orange-500/20 border border-amber-500/50 shadow-lg shadow-amber-500/20">
            <svg class="w-6 h-6 text-amber-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" set:html={step.icon} />
          </div>
          <!-- Content -->
          <div class="pt-1">
            <div class="text-sm font-bold text-amber-400 mb-1">{step.num}</div>
            <h3 class="text-base font-bold text-white mb-1">{step.title}</h3>
            <p class="text-sm text-slate-400 leading-relaxed">{step.desc}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
