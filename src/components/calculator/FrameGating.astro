---
// Frame 6: El Gating (Conversión - Lead Capture)
---

<div class="space-y-8">
  <!-- Modal Card -->
  <div class="mx-auto max-w-md bg-gradient-to-br from-slate-800 to-slate-900 rounded-xl border border-slate-700 p-8 space-y-6">
    <!-- Header -->
    <div class="text-center space-y-2">
      <div class="text-4xl">🚀</div>
      <h2 class="text-2xl font-bold text-white">¡Tu Hoja de Ruta REP está lista!</h2>
      <p class="text-slate-400">
        Te enviaremos el PDF con tus costos y metas anuales ahora mismo.
      </p>
    </div>

    <!-- Email Form -->
    <form id="gating-form" class="space-y-4" onsubmit="return window.onGatingSubmit(event)">
      <!-- Email Input -->
      <div class="space-y-2">
        <label for="email" class="block text-sm font-semibold text-slate-300">
          Correo corporativo
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          placeholder="nombre@empresa.cl"
          class="
            w-full px-4 py-3 rounded-lg bg-slate-700 border border-slate-600
            text-white placeholder-slate-400
            focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500
            transition-colors
          "
        />
      </div>

      <!-- Google Sign-In Option -->
      <div class="relative flex items-center gap-3">
        <div class="flex-1 border-t border-slate-600"></div>
        <span class="text-xs text-slate-500 px-2">o</span>
        <div class="flex-1 border-t border-slate-600"></div>
      </div>

      <button
        type="button"
        onclick="window.onGoogleSignIn()"
        class="
          w-full px-4 py-3 rounded-lg border border-slate-600
          bg-white text-slate-900 font-semibold
          hover:bg-slate-100 transition-colors
          flex items-center justify-center gap-3
        "
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
        </svg>
        <span>Continuar con Google</span>
      </button>

      <!-- Checkbox -->
      <div class="flex items-start gap-3 pt-2">
        <input
          type="checkbox"
          id="accept-terms"
          name="accept-terms"
          required
          class="
            mt-1 w-4 h-4 rounded border-slate-600 bg-slate-700
            text-amber-500 focus:ring-amber-500 cursor-pointer
          "
        />
        <label for="accept-terms" class="text-xs text-slate-400">
          Acepto recibir información sobre RAEE, Ley REP y actualizaciones de ElectroLoop
        </label>
      </div>

      <!-- Submit Button -->
      <button
        type="submit"
        class="
          w-full px-4 py-3 bg-gradient-to-r from-amber-500 to-orange-500
          text-white font-semibold rounded-lg
          hover:shadow-[0_0_20px_rgba(251,146,60,0.4)]
          active:scale-95
          transition-all duration-300
          mt-6
        "
      >
        📥 Descargar Informe Completo
      </button>
    </form>

    <!-- Legal Text -->
    <p class="text-xs text-slate-500 text-center">
      Tus datos se almacenan en conformidad con la LPDP. Nunca compartimos información con terceros.
    </p>
  </div>
</div>

<script>
  window.onGatingSubmit = (event) => {
    event.preventDefault();

    const emailEl = document.getElementById('email');
    const acceptTermsEl = document.getElementById('accept-terms');

    const email = emailEl ? emailEl.value : '';
    const acceptTerms = acceptTermsEl ? acceptTermsEl.checked : false;
    
    if (!email || !acceptTerms) {
      alert('Por favor completa todos los campos');
      return false;
    }

    window.calculatorState.userEmail = email;
    window.calculatorState.userAcceptTerms = acceptTerms;

    // Simulate submission (in real scenario, call API to generate PDF + send email)
    console.log('Submitting:', window.calculatorState);

    // Move to results
    window.navigateFrame(8);
    return false;
  };

  window.onGoogleSignIn = () => {
    alert('Google Sign-In integration coming soon');
    // In production: Initialize Google OAuth flow
  };
</script>
