---
// Frame 2: Selección de Categorías
---

<div class="space-y-8">
  <div class="text-center">
    <h2 class="text-3xl md:text-4xl font-bold text-white mb-2">
      ¿Qué equipos generan en tu empresa?
    </h2>
    <p class="text-slate-400">Selecciona las categorías que apliquen a tu operación</p>
  </div>

  <!-- Categories Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {[
      { id: 'temp', name: 'Intercambio de Temperatura', icon: '❄️', desc: 'Refrigeradores, A/C' },
      { id: 'monitors', name: 'Monitores y Pantallas', icon: '📺', desc: 'TVs, Laptops, Monitores' },
      { id: 'lamps', name: 'Lámparas', icon: '💡', desc: 'Tubos, LED fluorescentes' },
      { id: 'large', name: 'Grandes Aparatos', icon: '🔧', desc: 'Lavadoras, cocinas' },
      { id: 'small', name: 'Pequeños + IT', icon: '📱', desc: 'Celulares, herramientas' },
      { id: 'panels', name: 'Paneles Fotovoltaicos', icon: '⚡', desc: 'Módulos solares' },
      { id: 'batteries', name: 'Pilas y Baterías', icon: '🔋', desc: 'Alcalinas, litio, portátiles' },
      { id: 'other', name: 'Otros', icon: '📦', desc: 'Equipos especiales' }
    ].map((cat) => (
      <button
        type="button"
        onclick={`document.getElementById('cat-${cat.id}').click()`}
        class="
          group relative h-40 rounded-lg border-2 border-slate-700
          bg-gradient-to-br from-slate-800 to-slate-900
          hover:border-amber-500/50 hover:bg-slate-800
          transition-all duration-300
          overflow-hidden cursor-pointer
          has-[:checked]:border-amber-500 has-[:checked]:bg-amber-500/10 has-[:checked]:shadow-[0_0_20px_rgba(251,146,60,0.3)]
        "
      >
        <input
          type="checkbox"
          id={`cat-${cat.id}`}
          value={cat.id}
          class="hidden"
          onchange={`window.onCategoryChange?.('${cat.id}')`}
        />
        
        <div class="flex flex-col items-center justify-center h-full p-4 text-center space-y-2">
          <span class="text-4xl group-hover:scale-110 transition-transform">{cat.icon}</span>
          <span class="font-semibold text-white text-sm">{cat.name}</span>
          <span class="text-xs text-slate-400">{cat.desc}</span>
        </div>

        <!-- Checkmark -->
        <div class="absolute top-2 right-2 opacity-0 group-hover:opacity-100 transition-opacity">
          <svg class="w-6 h-6 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
        </div>
      </button>
    ))}
  </div>

  <!-- Action Buttons -->
  <div class="flex gap-4 pt-8">
    <button
      onclick="window.navigateFrame(1)"
      class="flex-1 px-4 py-3 border border-slate-600 text-slate-300 font-semibold rounded-lg hover:bg-slate-800 transition-colors"
    >
      Atrás
    </button>
    <button
      id="btn-next-categories"
      onclick="window.navigateFrame(5)"
      disabled
      class="
        flex-1 px-4 py-3 bg-amber-500 text-white font-semibold rounded-lg
        hover:bg-amber-600 disabled:bg-slate-700 disabled:text-slate-500
        disabled:cursor-not-allowed transition-colors
      "
    >
      Siguiente
    </button>
  </div>
</div>

<script>
  window.onCategoryChange = (categoryId) => {
    const checked = document.querySelector(`#cat-${categoryId}:checked`);
    const anyChecked = document.querySelectorAll('input[type="checkbox"]:checked').length > 0;
    const nextBtn = document.getElementById('btn-next-categories');

    if (nextBtn) {
      nextBtn.disabled = !anyChecked;
    }

    if (checked) {
      window.calculatorState.selectedCategories.push(categoryId);
      console.log('Category added:', categoryId, 'Total categories:', window.calculatorState.selectedCategories);
    } else {
      window.calculatorState.selectedCategories = window.calculatorState.selectedCategories.filter((c) => c !== categoryId);
      console.log('Category removed:', categoryId, 'Total categories:', window.calculatorState.selectedCategories);
    }
  };
</script>
