---
// HeroParticles.astro — Split hero: text left + "Ciclo Circular RAEE" 3D carousel right
// Cards with real product photos + per-card 360° Y-rotation on mouse drag
// Replace image src with licensed images placed in /public/images/carousel/
interface CardDef { src: string; label: string; }
const CARDS: CardDef[] = [
  { src: 'https://images.unsplash.com/photo-1567177662154-dfeb4c93b6ae?w=280&q=80', label: 'Iluminación' },
  { src: 'https://images.unsplash.com/photo-1511707171634-5f897ff02aa9?w=280&q=80', label: 'Celulares' },
  { src: 'https://images.unsplash.com/photo-1585515320310-259814833e62?w=280&q=80', label: 'Electrodomésticos' },
  { src: 'https://images.unsplash.com/photo-1496181133206-80ce9b88a853?w=280&q=80', label: 'Notebooks' },
  { src: 'https://images.unsplash.com/photo-1509391366360-2e959784a276?w=280&q=80', label: 'Energía Solar' },
  { src: 'https://images.unsplash.com/photo-1593941707882-a5bba14938c7?w=280&q=80', label: 'Baterías' },
  { src: 'https://images.unsplash.com/photo-1504148455328-c376907d081c?w=280&q=80', label: 'Herramientas' },
  { src: 'https://images.unsplash.com/photo-1461151304267-38535e780c79?w=280&q=80', label: 'TVs' },
  { src: 'https://images.unsplash.com/photo-1593359677879-a4bb92f829e1?w=280&q=80', label: 'Smart TVs' },
];
---

<section
  id="inicio"
  class="hero-section relative w-full min-h-screen flex items-center overflow-hidden"
  aria-label="Hero section"
>
  <!-- Grid texture background -->
  <div class="grid-bg absolute inset-0 pointer-events-none z-0" aria-hidden="true"></div>

  <!-- Spotlight SVG (left half sweep) -->
  <div class="spotlight-wrap absolute inset-0 pointer-events-none z-[1] overflow-hidden" aria-hidden="true">
    <svg class="spotlight-svg" viewBox="0 0 3787 2842" fill="none" xmlns="http://www.w3.org/2000/svg">
      <g filter="url(#spotlight-filter)">
        <ellipse cx="1924.71" cy="273.501" rx="1924.71" ry="273.501"
          transform="matrix(-0.822377 -0.568943 -0.568943 0.822377 3631.88 2291.09)"
          fill="white" fill-opacity="0.18"/>
      </g>
      <defs>
        <filter id="spotlight-filter" x="0.860352" y="0.81" width="3785.16" height="2840.26"
          filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
          <feFlood flood-opacity="0" result="BackgroundImageFix"/>
          <feBlend mode="normal" in="SourceGraphic" in2="BackgroundImageFix" result="shape"/>
          <feGaussianBlur stdDeviation="151" result="effect1_foregroundBlur"/>
        </filter>
      </defs>
    </svg>
  </div>

  <!-- Ambient glows -->
  <div class="absolute top-1/3 left-1/4 w-[600px] h-[600px] rounded-full pointer-events-none z-[2]" aria-hidden="true"
    style="background: radial-gradient(circle, rgba(185,115,51,0.08) 0%, transparent 65%); filter: blur(60px);"></div>
  <div class="absolute bottom-0 right-1/4 w-[400px] h-[400px] rounded-full pointer-events-none z-[2]" aria-hidden="true"
    style="background: radial-gradient(circle, rgba(59,130,246,0.04) 0%, transparent 70%); filter: blur(80px);"></div>

  <!-- 2-column layout -->
  <div class="relative z-20 max-w-7xl mx-auto px-6 sm:px-8 lg:px-16 w-full pt-24 pb-16">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-8 items-center" style="min-height: calc(100vh - 6rem);">

      <!-- LEFT: Text content -->
      <div class="flex flex-col justify-center">

        <!-- Eyebrow -->
        <div class="hero-eyebrow mb-8 overflow-hidden">
          <div class="eyebrow-inner flex items-center gap-3 opacity-0 translate-y-4">
            <div class="w-8 h-px" style="background: rgba(185,115,51,0.6);"></div>
            <span class="text-xs font-bold tracking-[0.28em] uppercase" style="color: rgba(185,115,51,0.75);">
              Integrador RAEE · Chile
            </span>
            <div class="w-8 h-px" style="background: rgba(185,115,51,0.3);"></div>
          </div>
        </div>

        <!-- Headline -->
        <h1 class="hero-headline font-black text-white mb-8"
          style="font-size: clamp(2.8rem, 5.5vw, 5.5rem); font-family: 'Poppins', sans-serif; line-height: 1.08; letter-spacing: -0.02em;">
          <span class="hero-line block overflow-hidden">
            <span class="hero-line-inner block">La gestión RAEE</span>
          </span>
          <span class="hero-line block overflow-hidden">
            <span class="hero-line-inner block">que la macrozona</span>
          </span>
          <span class="hero-line block overflow-hidden">
            <span class="hero-line-inner block">
              <em class="not-italic" style="color: #FB923C;">norte</em> necesita.
            </span>
          </span>
        </h1>

        <!-- Subtitle -->
        <div class="hero-subtitle-wrap overflow-hidden mb-10">
          <p class="hero-subtitle max-w-lg text-base sm:text-lg leading-relaxed opacity-0"
            style="color: rgba(255,255,255,0.55);">
            Un solo punto de contacto, responsabilidad integral.
            Operamos con <strong style="color: rgba(255,255,255,0.85);">partners certificados</strong>
            mientras construimos capacidad propia.
            <strong style="color: #FB923C;">Inicio operativo agosto 2026.</strong>
          </p>
        </div>

        <!-- CTAs -->
        <div class="hero-cta flex flex-col sm:flex-row gap-4 opacity-0">
          <a href="#contacto"
            class="magnetic-btn group relative inline-flex items-center gap-3 px-8 py-4 rounded-2xl text-sm font-bold text-white overflow-hidden"
            style="background: linear-gradient(135deg, #B97333, #D4894A); box-shadow: 0 8px 32px rgba(185,115,51,0.35);"
            data-magnetic>
            <span class="relative z-10 flex items-center gap-2">
              <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              Pre-registrarme como cliente ancla
            </span>
            <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
              style="background: linear-gradient(135deg, #D4894A, #FB923C);"></div>
          </a>

          <a href="#cadena"
            class="magnetic-btn group inline-flex items-center gap-3 px-8 py-4 rounded-2xl text-sm font-bold transition-all duration-300"
            style="color: rgba(255,255,255,0.75); border: 1.5px solid rgba(255,255,255,0.12);"
            data-magnetic>
            <span>Ver cómo funciona</span>
            <svg class="w-4 h-4 transition-transform duration-400 group-hover:translate-y-1"
              fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
            </svg>
          </a>
        </div>

      </div>

      <!-- RIGHT: "Ciclo Circular RAEE" 3D carousel -->
      <div class="devices-panel relative" aria-hidden="true">
        <div class="stage" id="cc-stage">

          <!-- ambient dashed ring -->
          <div class="backring"></div>

          <!-- 9 device cards — product photo front + ElectroLoop recycling back -->
          <!-- Drag each card individually to rotate 360° on its own axis -->
          {CARDS.map((card, i) => (
            <div class="card3d" data-i={i}>
              <div class="card-inner">
                <div class="card-face card-front">
                  <div class="card-img-win">
                    <img src={card.src} class="card-img" alt={card.label} loading="lazy" draggable="false" />
                  </div>
                  <div class="cap"><div class="name">{card.label}</div><div class="bar"></div></div>
                </div>
                <div class="card-face card-back">
                  <svg class="back-recy" viewBox="0 0 24 24" fill="none" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 19H4.815a1.83 1.83 0 0 1-1.57-.881 1.785 1.785 0 0 1-.004-1.784L7.196 9.5"/>
                    <path d="M11 19h8.203a1.83 1.83 0 0 0 1.556-.89 1.784 1.784 0 0 0 0-1.775l-1.226-2.12"/>
                    <path d="m14 16-3 3 3 3"/><path d="M8.293 13.596 7.196 9.5 3.1 10.598"/>
                    <path d="m9.344 5.811 1.093-1.892A1.83 1.83 0 0 1 11.985 3a1.784 1.784 0 0 1 1.546.888l3.943 6.843"/>
                    <path d="m13.378 9.633 4.096 1.098 1.097-4.096"/>
                  </svg>
                  <div class="cap"><div class="name back-brand">ElectroLoop</div><div class="bar"></div></div>
                </div>
              </div>
            </div>
          ))}

          <!-- central recycle hub -->
          <div class="hub">
            <svg class="recycle" viewBox="0 0 24 24" fill="none" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 19H4.815a1.83 1.83 0 0 1-1.57-.881 1.785 1.785 0 0 1-.004-1.784L7.196 9.5"/>
              <path d="M11 19h8.203a1.83 1.83 0 0 0 1.556-.89 1.784 1.784 0 0 0 0-1.775l-1.226-2.12"/>
              <path d="m14 16-3 3 3 3"/>
              <path d="M8.293 13.596 7.196 9.5 3.1 10.598"/>
              <path d="m9.344 5.811 1.093-1.892A1.83 1.83 0 0 1 11.985 3a1.784 1.784 0 0 1 1.546.888l3.943 6.843"/>
              <path d="m13.378 9.633 4.096 1.098 1.097-4.096"/>
            </svg>
          </div>

          <!-- drag hint -->
          <div class="cc-hint" id="cc-hint">
            <svg viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 6 6 9l3 3"/><path d="m15 6 3 3-3 3"/><path d="M6 9h12"/>
            </svg>
            Arrastra para girar
          </div>

        </div>
      </div>

    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="scroll-indicator absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-3 z-20 opacity-0" aria-hidden="true">
    <span class="text-[9px] font-bold tracking-[0.4em] uppercase" style="color: rgba(255,255,255,0.25);">Scroll</span>
    <div class="scroll-track relative w-px h-12 overflow-hidden" style="background: rgba(255,255,255,0.1);">
      <div class="scroll-line absolute inset-x-0 h-full"
        style="background: linear-gradient(to bottom, #B97333, transparent); animation: scrollDown 1.8s ease-in-out infinite;"></div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';

  const prefersNoMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ─── ENTRANCE ANIMATION ───────────────────────────────────────

  if (!prefersNoMotion) {
    const tl = gsap.timeline({ delay: 0.2 });
    tl.to('.eyebrow-inner', { opacity: 1, y: 0, duration: 0.9, ease: 'power4.out' });
    tl.fromTo('.hero-line-inner', { y: '105%' }, { y: '0%', duration: 1.1, ease: 'expo.out', stagger: 0.13 }, '-=0.55');
    tl.to('.hero-subtitle', { opacity: 1, y: 0, duration: 0.9, ease: 'power3.out' }, '-=0.65');
    tl.to('.hero-cta', { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out' }, '-=0.55');
    tl.to('.scroll-indicator', { opacity: 1, duration: 0.6, ease: 'power2.out' }, '-=0.3');
  } else {
    document.querySelectorAll('.eyebrow-inner, .hero-subtitle, .hero-cta, .scroll-indicator')
      .forEach(el => { el.style.opacity = '1'; el.style.transform = 'none'; });
    document.querySelectorAll('.hero-line-inner')
      .forEach(el => { el.style.transform = 'none'; });
  }

  // ─── MAGNETIC BUTTONS ─────────────────────────────────────────

  if (!prefersNoMotion) {
    document.querySelectorAll('[data-magnetic]').forEach(btn => {
      btn.addEventListener('mousemove', (e) => {
        const r = btn.getBoundingClientRect();
        const x = (e.clientX - r.left - r.width  / 2) * 0.28;
        const y = (e.clientY - r.top  - r.height / 2) * 0.28;
        gsap.to(btn, { x, y, duration: 0.35, ease: 'power3.out', overwrite: true });
      });
      btn.addEventListener('mouseleave', () => {
        gsap.to(btn, { x: 0, y: 0, duration: 0.6, ease: 'elastic.out(1, 0.45)', overwrite: true });
      });
    });
  }

  // ─── CICLO CIRCULAR RAEE — 3D CAROUSEL ────────────────────────
  // Cards orbit an elliptical ring around a central recycle hub.
  // Auto-spin (30s/rev) + drag-to-rotate with inertia + cursor parallax.

  const stage = document.getElementById('cc-stage');

  if (stage) {
    const cards = [...stage.querySelectorAll('.card3d')];
    const hint  = stage.querySelector('.cc-hint');
    const N     = cards.length;
    const TWO_PI = Math.PI * 2;
    const OMEGA  = TWO_PI / 30;        // one revolution every 30s
    const MAX_TILT = 32;              // deg of yaw at the sides
    const clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));

    let Rx = 167, Ry = 96, Z = 170;
    function measure() {
      const w = stage.clientWidth, h = stage.clientHeight, m = Math.min(w, h);
      Rx = clamp(w * 0.34, 135, 240);   // horizontal reach (wider for 9 cards)
      Ry = clamp(h * 0.165, 60, 120);   // vertical arc (keeps hub visible)
      Z  = clamp(m * 0.34, 110, 195);   // depth
    }
    measure();
    window.addEventListener('resize', measure, { passive: true });

    let angle        = -Math.PI / 2 + 0.0001;
    let vel          = OMEGA;
    let dragging     = false;
    let cardDragging = -1;   // index of card currently being rotated individually
    let last         = performance.now();

    function layout() {
      let frontIdx = 0, frontCos = -2;
      for (let i = 0; i < N; i++) {
        const a  = angle + i * (TWO_PI / N);
        const s  = Math.sin(a);
        const co = Math.cos(a);
        const x  = s * Rx;
        const y  = co * Ry;            // front (co=1) dips down, back lifts up
        const z  = co * Z;             // front toward viewer
        const depth = (co + 1) / 2;    // 0 = far, 1 = near
        const scale = 0.56 + 0.36 * depth;
        const tilt  = -s * MAX_TILT;
        const c = cards[i];
        c.style.transform =
          `translate3d(${x.toFixed(1)}px, ${y.toFixed(1)}px, ${z.toFixed(1)}px) rotateY(${tilt.toFixed(1)}deg) scale(${scale.toFixed(3)})`;
        c.style.zIndex  = String(Math.round(co * 100) + 110);
        c.style.opacity = (0.30 + 0.70 * depth).toFixed(3);
        c.style.filter  = `brightness(${(0.50 + 0.50 * depth).toFixed(3)}) saturate(${(0.7 + 0.3 * depth).toFixed(2)})`;
        if (co > frontCos) { frontCos = co; frontIdx = i; }
      }
      cards.forEach((c, i) => c.classList.toggle('active', i === frontIdx));
    }

    function frame(now) {
      let dt = (now - last) / 1000; last = now;
      if (dt > 0.05) dt = 0.05;
      if (!dragging && cardDragging < 0) {
        vel += (OMEGA - vel) * Math.min(1, dt * 1.4);   // ease back to auto-spin
        angle += vel * dt;
      }
      layout();
      requestAnimationFrame(frame);
    }

    layout();
    if (!prefersNoMotion) requestAnimationFrame(frame);

    // ── Drag to rotate (Pointer Events) + parallax ──
    let lastX = 0, lastT = 0;

    stage.addEventListener('pointerdown', (e) => {
      dragging = true;
      lastX = e.clientX; lastT = performance.now();
      document.body.classList.add('cc-grabbing');
      if (hint) hint.classList.add('hide');
      try { stage.setPointerCapture(e.pointerId); } catch (_) {}
    });

    window.addEventListener('pointermove', (e) => {
      const r = stage.getBoundingClientRect();
      const nx = clamp(((e.clientX - r.left) / r.width  - 0.5) * 2, -1, 1);
      const ny = clamp(((e.clientY - r.top)  / r.height - 0.5) * 2, -1, 1);
      if (!dragging) {
        if (!prefersNoMotion)
          stage.style.perspectiveOrigin = `${(50 + nx * 6).toFixed(1)}% ${(46 + ny * 5).toFixed(1)}%`;
        return;
      }
      const now = performance.now();
      let dt = (now - lastT) / 1000; if (dt <= 0) dt = 0.016;
      const dA = (e.clientX - lastX) * 0.0068;   // px → radians
      angle += dA;
      vel = clamp(dA / dt, -9, 9);
      lastX = e.clientX; lastT = now;
      layout();   // immediate response while dragging
    }, { passive: true });

    function endDrag() {
      if (!dragging) return;
      dragging = false;
      document.body.classList.remove('cc-grabbing');
    }
    window.addEventListener('pointerup', endDrag);
    window.addEventListener('pointercancel', endDrag);

    if (hint) setTimeout(() => hint.classList.add('hide'), 6000);

    // ── Per-card 360° Y-rotation on individual drag ──
    // Drag a card directly to spin it on its own axis (front→back→front).
    // stopPropagation prevents the carousel-ring drag from activating at the same time.
    const cardInners    = cards.map(c => c.querySelector('.card-inner'));
    const cardRots      = new Array(N).fill(0);
    let   cardDragX     = 0;
    let   cardDragStart = 0;

    cards.forEach((card, idx) => {
      card.addEventListener('pointerdown', (e) => {
        e.stopPropagation();          // don't start carousel drag
        cardDragging  = idx;
        cardDragX     = e.clientX;
        cardDragStart = cardRots[idx];
        try { card.setPointerCapture(e.pointerId); } catch (_) {}
        cardInners[idx]?.classList.add('spinning');
        document.body.classList.add('cc-grabbing');
        if (hint) hint.classList.add('hide');
      });

      card.addEventListener('pointermove', (e) => {
        if (cardDragging !== idx) return;
        const dx = e.clientX - cardDragX;
        cardRots[idx] = cardDragStart + dx * 0.55;   // ~0.55 deg per px
        if (cardInners[idx])
          cardInners[idx].style.transform = `rotateY(${cardRots[idx]}deg)`;
      });

      const endCardDrag = () => {
        if (cardDragging !== idx) return;
        cardDragging = -1;
        cardInners[idx]?.classList.remove('spinning');
        document.body.classList.remove('cc-grabbing');
      };
      card.addEventListener('pointerup',           endCardDrag);
      card.addEventListener('pointercancel',        endCardDrag);
      card.addEventListener('lostpointercapture',   endCardDrag);
    });
  }
</script>

<style>
  .hero-section {
    background-color: #030B18;
  }

  .grid-bg {
    background-image:
      linear-gradient(rgba(185,115,51,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(185,115,51,0.04) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 30%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 30%, transparent 100%);
  }

  .spotlight-svg {
    position: absolute;
    top: -25%;
    left: -5%;
    width: 75%;
    height: auto;
    pointer-events: none;
    animation: spotlightPan 8s ease-in-out infinite;
  }

  @keyframes spotlightPan {
    0%, 100% { transform: translate(0, 0) rotate(0deg); opacity: 0.6; }
    40%       { transform: translate(40px, -30px) rotate(3deg); opacity: 1; }
    70%       { transform: translate(-25px, 15px) rotate(-2deg); opacity: 0.75; }
  }

  .hero-line-inner {
    display: block;
    will-change: transform;
    transform: translateY(105%);
  }

  .hero-subtitle { transform: translateY(16px); }
  .hero-cta      { transform: translateY(16px); }

  @keyframes scrollDown {
    0%   { transform: translateY(-100%); opacity: 1; }
    70%  { opacity: 1; }
    100% { transform: translateY(100%); opacity: 0; }
  }

  /* ════════ CICLO CIRCULAR RAEE — 3D CAROUSEL ════════ */
  .devices-panel { height: 580px; }

  .stage {
    position: relative;
    width: 100%;
    height: 100%;
    perspective: 1200px;
    perspective-origin: 50% 46%;
    cursor: grab;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    transition: perspective-origin .4s ease-out;
    animation: ccRise 1.3s cubic-bezier(.2,.7,.2,1) both;
    /* responsive geometry tokens */
    --cardw: clamp(108px, 13.5vmin, 150px);
    --cardh: clamp(136px, 17vmin, 188px);
    --icon:  clamp(36px, 6vmin, 58px);
    --core:  clamp(92px, 14vmin, 142px);
    --recy:  clamp(42px, 7vmin, 68px);
  }
  :global(body.cc-grabbing) .stage { cursor: grabbing; transition: none; }

  @keyframes ccRise { from { opacity: 0; transform: scale(.92); } to { opacity: 1; transform: scale(1); } }

  /* ambient dashed ring + halo */
  .backring {
    position: absolute; left: 50%; top: 46%; transform: translate(-50%, -50%);
    width: clamp(240px, 78%, 460px); height: clamp(240px, 78%, 460px);
    border-radius: 50%;
    border: 1px dashed rgba(184,115,51,0.16);
    box-shadow: inset 0 0 90px rgba(184,115,51,0.05);
    z-index: 1;
    animation: ccSpin 120s linear infinite;
  }
  .backring::after {
    content: ''; position: absolute; inset: 13%;
    border-radius: 50%; border: 1px solid rgba(255,255,255,0.05);
  }
  @keyframes ccSpin { to { transform: translate(-50%, -50%) rotate(360deg); } }

  /* central recycle hub */
  .hub {
    position: absolute; left: 50%; top: 46%; transform: translate(-50%, -50%);
    width: var(--core); height: var(--core); border-radius: 50%;
    background:
      radial-gradient(125% 125% at 38% 30%, rgba(255,255,255,0.08) 0%, transparent 26%),
      radial-gradient(120% 120% at 40% 32%, #16294a 0%, #0e1d36 60%, #0a1730 100%);
    border: 1px solid rgba(184,115,51,0.42);
    box-shadow:
      0 40px 90px -20px rgba(0,0,0,0.78),
      0 0 0 9px rgba(184,115,51,0.05),
      inset 0 2px 0 rgba(255,255,255,0.07);
    display: flex; align-items: center; justify-content: center;
    z-index: 100;
  }
  .hub::after {
    content: ''; position: absolute; inset: 0; border-radius: 50%;
    box-shadow: 0 0 60px 8px rgba(184,115,51,0.30);
    animation: ccPulse 4.8s ease-in-out infinite;
  }
  .recycle { width: var(--recy); height: var(--recy); animation: ccSpinR 30s linear infinite; }
  .recycle * { stroke: #B87333; }
  @keyframes ccSpinR { to { transform: rotate(360deg); } }
  @keyframes ccPulse { 0%,100% { opacity: .42; transform: scale(.98); } 50% { opacity: .92; transform: scale(1.03); } }

  /* device cards */
  .card3d {
    position: absolute; left: 50%; top: 46%;
    width: var(--cardw); height: var(--cardh);
    margin-left: calc(var(--cardw) / -2); margin-top: calc(var(--cardh) / -2);
