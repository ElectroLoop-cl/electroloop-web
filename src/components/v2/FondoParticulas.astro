---
/**
 * ELECTROLOOP v2 — Fondo de partículas de la portada para heros de páginas interiores.
 * Usa la misma escena WebGL que HeroV2 (carga diferida). El contenedor debe tener
 * position: relative; sin WebGL la página se ve igual, sin fondo animado.
 */
---

<canvas class="v2-fondo-particulas" aria-hidden="true" data-fondo-particulas></canvas>

<style>
  .v2-fondo-particulas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    opacity: 0.75;
  }
</style>

<script>
  function loadScene() {
    const canvas = document.querySelector<HTMLCanvasElement>('[data-fondo-particulas]');
    if (!canvas) return;
    import('../../scripts/v2/hero-particles.ts')
      .then(({ initHeroParticles }) => initHeroParticles(canvas))
      .catch(() => { /* sin escena: el hero se sostiene solo */ });
  }

  function start() {
    if ('requestIdleCallback' in window) {
      requestIdleCallback(loadScene, { timeout: 1500 });
    } else {
      setTimeout(loadScene, 300);
    }
  }

  if ((window as any).__v2Revealed) {
    start();
  } else {
    document.addEventListener('v2:reveal', start, { once: true });
  }
</script>
