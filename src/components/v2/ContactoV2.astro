---
/**
 * ELECTROLOOP v2 — 07 / CONTACTO "Pre-registro".
 * Formulario técnico (Netlify Forms) + bloque mono de datos duros.
 * Categorías KISS: Productor / Comercializador / Otro.
 */
---

<section id="contacto" class="v2-section v2-light v2-contact" data-section="Contacto" data-index="08">
  <header class="v2-sechead">
    <span class="sh-idx">08</span>
    <h2 class="sh-name">Contacto — Pre-Registro</h2>
    <i class="v2-drawline" aria-hidden="true"></i>
  </header>

  <div class="ct-grid">
    <form
      class="ct-form"
      name="contacto-v2"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      action="/?form=ok"
    >
      <input type="hidden" name="form-name" value="contacto-v2" />
      <p class="hp" aria-hidden="true">
        <label>No llenar: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
      </p>

      <h3 class="ct-title">
        Pre-registra tu empresa.<br />
        <strong>Tarifa preferencial + prioridad logística.</strong>
      </h3>

      <fieldset class="ct-cat">
        <legend class="v2-mono v2-mono--steel">[ TU EMPRESA ES ]</legend>
        <label class="chip">
          <input type="radio" name="categoria" value="productor" required />
          <span>PRODUCTOR</span>
        </label>
        <label class="chip">
          <input type="radio" name="categoria" value="comercializador" />
          <span>COMERCIALIZADOR</span>
        </label>
        <label class="chip">
          <input type="radio" name="categoria" value="otro" />
          <span>OTRO</span>
        </label>
      </fieldset>

      <div class="ct-fields">
        <label class="field">
          <span class="v2-mono v2-mono--steel">NOMBRE *</span>
          <input type="text" name="nombre" required autocomplete="name" />
        </label>
        <label class="field">
          <span class="v2-mono v2-mono--steel">EMPRESA</span>
          <input type="text" name="empresa" autocomplete="organization" />
        </label>
        <label class="field">
          <span class="v2-mono v2-mono--steel">EMAIL *</span>
          <input type="email" name="email" required autocomplete="email" />
        </label>
        <label class="field field-full">
          <span class="v2-mono v2-mono--steel">MENSAJE</span>
          <textarea name="mensaje" rows="3"></textarea>
        </label>
      </div>

      <button type="submit" class="ct-submit v2-mono" data-magnetic data-cursor="[ ENVIAR ]">
        ENVIAR FORMULARIO <span class="arrow">→</span>
        <i class="v2-drawline" aria-hidden="true"></i>
      </button>
      <p class="ct-status v2-mono" role="status" aria-live="polite" hidden></p>
    </form>

    <!-- Datos duros de la empresa -->
    <aside class="ct-data v2-mono" aria-label="Datos de la empresa">
      <span class="d-row">CHILE</span>
      <i class="d-sep" aria-hidden="true"></i>
      <span class="d-row">COBERTURA: NACIONAL</span>
      <i class="d-sep" aria-hidden="true"></i>
      <span class="d-row">contacto@electroloop.cl</span>
    </aside>
  </div>
</section>

<style>
  .ct-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: 24px;
    row-gap: 56px;
    align-items: start;
  }

  .ct-form { grid-column: 1 / 8; }
  .hp { position: absolute; left: -9999px; }

  .ct-title {
    margin: 0 0 clamp(28px, 4vh, 44px);
    font-size: clamp(1.5rem, 2.9vw, 2.6rem);
    font-weight: 300;
    line-height: 1.3;
  }
  .ct-title strong { font-weight: 800; }

  /* ---------- Categorías: chips técnicos ---------- */
  .ct-cat {
    border: none;
    margin: 0 0 clamp(24px, 3.5vh, 40px);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }
  .ct-cat legend {
    font-size: 0.62rem;
    margin-bottom: 12px;
    padding: 0;
  }
  .chip { cursor: pointer; }
  .chip input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .chip span {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    padding: 10px 18px;
    border: 1px solid rgba(11, 27, 50, 0.35);
    color: var(--abyssal);
    transition: background-color 0.35s var(--ease-blueprint), color 0.35s var(--ease-blueprint),
                border-color 0.35s var(--ease-blueprint);
  }
  .chip:hover span { border-color: var(--copper); color: var(--copper); }
  .chip input:checked + span {
    background: var(--copper);
    border-color: var(--copper);
    color: var(--ceramic);
  }
  .chip input:focus-visible + span {
    outline: 2px solid var(--copper);
    outline-offset: 3px;
  }

  /* ---------- Campos: línea de formulario técnico ---------- */
  .ct-fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(24px, 3vh, 36px) 32px;
    margin-bottom: clamp(32px, 5vh, 48px);
  }
  .field { display: flex; flex-direction: column; gap: 8px; }
  .field-full { grid-column: 1 / -1; }
  .field span { font-size: 0.6rem; }
  .field input,
  .field textarea {
    border: none;
    border-bottom: 1px solid rgba(11, 27, 50, 0.35);
    background: transparent;
    padding: 8px 0;
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--abyssal);
    border-radius: 0;
    resize: vertical;
    transition: border-color 0.35s var(--ease-blueprint);
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-bottom-color: var(--copper);
    border-bottom-width: 2px;
  }

  .ct-submit {
    position: relative;
    background: none;
    border: none;
    cursor: pointer;
    padding: 14px 2px;
    color: var(--abyssal);
    font-weight: 700;
    letter-spacing: 0.12em;
  }
  .ct-submit .arrow {
    color: var(--copper);
    display: inline-block;
    transition: transform 0.45s var(--ease-blueprint);
  }
  .ct-submit:hover .arrow { transform: translateX(6px); }
  .ct-submit .v2-drawline { position: absolute; left: 0; right: 0; bottom: 6px; }

  /* ---------- Bloque de datos ---------- */
  .ct-data {
    grid-column: 9 / 13;
    display: flex;
    flex-direction: column;
    gap: 10px;
    border: 1px solid rgba(11, 27, 50, 0.25);
    padding: clamp(20px, 2.5vw, 32px);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: var(--abyssal);
  }
  .d-sep { height: 1px; background: rgba(11, 27, 50, 0.18); margin: 8px 0; }
  .d-copper { color: var(--copper-ink, var(--copper)); font-weight: 700; }

  .ct-status {
    margin: 20px 0 0;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    line-height: 1.6;
    color: var(--abyssal);
  }
  .ct-status.is-error { color: #b42318; }

  @media (max-width: 767px) {
    .ct-form, .ct-data { grid-column: 1 / 13; }
    .ct-fields { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Envía el pre-registro a Netlify Forms y avisa al equipo por correo.
  // Sin JavaScript el formulario sigue funcionando con el POST nativo.
  const form = document.querySelector<HTMLFormElement>('form[name="contacto-v2"]');
  const status = form?.querySelector<HTMLParagraphElement>('.ct-status');
  const submit = form?.querySelector<HTMLButtonElement>('.ct-submit');

  const show = (msg: string, isError = false) => {
    if (!status) return;
    status.textContent = msg;
    status.classList.toggle('is-error', isError);
    status.hidden = false;
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (submit) submit.disabled = true;
    const data = new FormData(form);

    try {
      const res = await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(data as unknown as Record<string, string>).toString(),
      });
      if (!res.ok) throw new Error(`Netlify Forms ${res.status}`);

      // El contacto ya quedó guardado; el aviso por correo no debe bloquear al usuario.
      fetch('/.netlify/functions/send-autoresponse', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          nombre: data.get('nombre'),
          email: data.get('email'),
          empresa: data.get('empresa'),
          categoria: data.get('categoria'),
          mensaje: data.get('mensaje'),
          origen: location.pathname,
        }),
      }).catch((err) => console.warn('Aviso por correo falló:', err));

      form.reset();
      show('[ RECIBIDO ] Gracias. Te contactaremos dentro de 1 día hábil. Revisa tu correo.');
      window.posthog?.capture?.('contacto_enviado', { categoria: data.get('categoria') });
    } catch (err) {
      console.error('Error enviando formulario:', err);
      show('No pudimos enviar el formulario. Escríbenos a contacto@electroloop.cl', true);
    } finally {
      if (submit) submit.disabled = false;
    }
  });
</script>
