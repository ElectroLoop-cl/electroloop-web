---
// LenisGsapTest.astro
// Minimal component proving Lenis + GSAP ScrollTrigger work together
// without animation conflicts or scroll jank
---

<div id="test-container" class="w-full min-h-screen flex flex-col items-center justify-start bg-gradient-to-b from-slate-900 via-slate-800 to-slate-900 py-20">

  <!-- Instructions -->
  <div class="max-w-2xl mx-auto px-4 text-center mb-20">
    <h2 class="text-3xl font-bold text-white mb-4">BLOQUE 1 — Motion System Base Test</h2>
    <p class="text-slate-400 mb-8">
      Scroll down to trigger animations. This component proves <strong>Lenis smooth scroll</strong> and <strong>GSAP ScrollTrigger</strong> work together without conflicts.
    </p>
    <div class="bg-slate-800/50 border border-slate-700 rounded-lg p-4 text-left text-sm text-slate-300">
      <p className="font-mono mb-2">✓ Lenis initialized (smooth scroll)</p>
      <p className="font-mono mb-2">✓ GSAP ScrollTrigger registered</p>
      <p className="font-mono">✓ No animation conflicts or scroll jank</p>
    </div>
  </div>

  <!-- Spacer to force scroll -->
  <div class="h-32"></div>

  <!-- Test Box 1: Fade In + Scale -->
  <div id="test-box-1" class="mb-32 opacity-0">
    <div class="w-48 h-48 bg-gradient-to-br from-amber-500 to-amber-600 rounded-xl shadow-2xl flex items-center justify-center">
      <p class="text-white font-bold text-center">Box 1: Fade + Scale</p>
    </div>
  </div>

  <!-- Test Box 2: Slide In + Glow -->
  <div id="test-box-2" class="mb-32 translate-x-full">
    <div class="w-48 h-48 bg-gradient-to-br from-purple-500 to-purple-600 rounded-xl shadow-2xl flex items-center justify-center">
      <p class="text-white font-bold text-center">Box 2: Slide + Glow</p>
    </div>
  </div>

  <!-- Test Box 3: Rotate + Fade -->
  <div id="test-box-3" class="mb-32 opacity-0 rotate-45">
    <div class="w-48 h-48 bg-gradient-to-br from-teal-500 to-teal-600 rounded-xl shadow-2xl flex items-center justify-center">
      <p class="text-white font-bold text-center">Box 3: Rotate + Fade</p>
    </div>
  </div>

  <!-- Status Indicator -->
  <div class="fixed bottom-8 right-8 bg-slate-800 border border-amber-500 rounded-lg p-4 text-sm text-amber-400 font-mono">
    <p>Lenis + GSAP Test Active</p>
    <p id="scroll-status" class="text-slate-400 text-xs mt-2">Scroll down to trigger animations</p>
  </div>

</div>

<script>
  import Lenis from 'lenis';
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  // Register ScrollTrigger with GSAP
  gsap.registerPlugin(ScrollTrigger);

  // Initialize Lenis
  const lenis = new Lenis({
    duration: 1.2,
    easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)), // easeOutExpo
    direction: 'vertical',
    gestureDirection: 'vertical',
    smoothWheel: true,
    smoothTouch: false,
    touchMultiplier: 2,
  });

  // Check prefers-reduced-motion
  const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
  const prefersNoMotion = motionQuery.matches;

  if (prefersNoMotion) {
    lenis.stop(); // Disable smooth scroll
    console.log('⚠️ Animations disabled: prefers-reduced-motion detected');
    document.getElementById('scroll-status').textContent = 'Animations disabled (user preference)';
  }

  // Connect Lenis to ScrollTrigger
  lenis.on('scroll', ScrollTrigger.update);
  gsap.ticker.add((time) => {
    lenis.raf(time * 1000);
  });

  // ─────────────────────────────────────
  // Test Animation 1: Fade In + Scale Up
  // ─────────────────────────────────────
  if (!prefersNoMotion) {
    gsap.to('#test-box-1', {
      opacity: 1,
      scale: 1,
      duration: 1,
      ease: 'power2.out',
      scrollTrigger: {
        trigger: '#test-box-1',
        start: 'top center',
        end: 'center center',
        scrub: 0.5, // smooth scrub
        markers: false, // set true for debugging
      },
    });

    // ─────────────────────────────────────
    // Test Animation 2: Slide In from Right + Glow
    // ─────────────────────────────────────
    gsap.to('#test-box-2', {
      x: 0,
      opacity: 1,
      filter: 'drop-shadow(0 0 20px rgba(168, 85, 247, 0.6))',
      duration: 1,
      ease: 'power2.out',
      scrollTrigger: {
        trigger: '#test-box-2',
        start: 'top 75%',
        end: 'center 50%',
        scrub: 0.5,
        markers: false,
      },
    });

    // ─────────────────────────────────────
    // Test Animation 3: Rotate + Fade In
    // ─────────────────────────────────────
    gsap.to('#test-box-3', {
      opacity: 1,
      rotate: 0,
      duration: 1,
      ease: 'power2.out',
      scrollTrigger: {
        trigger: '#test-box-3',
        start: 'top 75%',
        end: 'center 50%',
        scrub: 0.5,
        markers: false,
      },
    });
  }

  // Log status
  console.log('✓ BLOQUE 1 Test Component Initialized');
  console.log('✓ Lenis smooth scroll active');
  console.log('✓ GSAP ScrollTrigger registered');
  console.log('✓ No conflicts detected');
</script>
