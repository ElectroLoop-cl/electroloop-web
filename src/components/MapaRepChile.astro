---
// MapaRepChile.astro
// BLOQUE 3b: Interactive D3.js map of Chile showing REP coverage
// Regions colored by compliance level, La Serena highlighted

interface Region {
  name: string;
  compliance: 'completo' | 'parcial' | 'planificado';
  active: boolean;
}

const regions: Region[] = [
  { name: 'Arica y Parinacota', compliance: 'parcial', active: false },
  { name: 'Tarapacá', compliance: 'parcial', active: false },
  { name: 'Antofagasta', compliance: 'completo', active: false },
  { name: 'Atacama', compliance: 'completo', active: false },
  { name: 'Coquimbo', compliance: 'completo', active: true }, // La Serena is here
  { name: 'Valparaíso', compliance: 'completo', active: false },
  { name: 'Metropolitana', compliance: 'completo', active: false },
  { name: 'O\'Higgins', compliance: 'completo', active: false },
  { name: 'Maule', compliance: 'completo', active: false },
  { name: 'Ñuble', compliance: 'completo', active: false },
  { name: 'Araucanía', compliance: 'parcial', active: false },
  { name: 'Los Ríos', compliance: 'parcial', active: false },
  { name: 'Los Lagos', compliance: 'parcial', active: false },
  { name: 'Aysén', compliance: 'planificado', active: false },
  { name: 'Magallanes', compliance: 'planificado', active: false },
];

const complianceColors = {
  completo: '#10B981',      // emerald (green)
  parcial: '#F59E0B',       // amber (yellow)
  planificado: '#6B7280',   // gray
};
---

<section id="mapa-rep" class="w-full py-24 bg-gradient-to-b from-slate-900 to-slate-800">
  <div class="max-w-6xl mx-auto px-4">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold text-white mb-4">
        Cobertura REP <span class="text-amber-500">en Chile</span>
      </h2>
      <p class="text-slate-400 max-w-2xl mx-auto">
        Nuestra red de partners certificados opera en regiones estratégicas de Chile. ElectroLoop se expande para llegar a más zonas en 2026-2027.
      </p>
    </div>

    <!-- Map Container -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
      <!-- Map -->
      <div class="lg:col-span-2 bg-slate-800/50 border border-slate-700 rounded-xl overflow-hidden p-6">
        <div id="map-container" class="w-full h-96 flex items-center justify-center bg-slate-900 rounded-lg overflow-hidden">
          <!-- D3.js map will be injected here -->
          <svg id="chile-map" class="w-full h-full" viewBox="0 0 200 600" xmlns="http://www.w3.org/2000/svg">
            <!-- Simplified Chile regional map (SVG fallback) -->
            <defs>
              <filter id="map-shadow" x="-50%" y="-50%" width="200%" height="200%">
                <feDropShadow dx="0" dy="2" stdDeviation="3" flood-opacity="0.3"/>
              </filter>
            </defs>

            <!-- North regions -->
            <rect x="20" y="20" width="160" height="40" fill="#F59E0B" opacity="0.7" class="region" data-region="Arica" filter="url(#map-shadow)"/>
            <text x="100" y="50" font-size="10" fill="white" text-anchor="middle" class="pointer-events-none">Arica</text>

            <!-- Central regions (highlighted) -->
            <rect x="20" y="200" width="160" height="50" fill="#FB923C" opacity="0.9" class="region active" data-region="Coquimbo" filter="url(#map-shadow)"/>
            <text x="100" y="230" font-size="11" fill="white" text-anchor="middle" font-weight="bold" class="pointer-events-none">La Serena</text>

            <!-- Southern regions -->
            <rect x="20" y="350" width="160" height="80" fill="#6B7280" opacity="0.6" class="region" data-region="Sur" filter="url(#map-shadow)"/>
            <text x="100" y="395" font-size="10" fill="white" text-anchor="middle" class="pointer-events-none">Regiones Planificadas</text>

            <!-- Legend indicators -->
            <circle cx="30" cy="500" r="4" fill="#10B981"/>
            <text x="40" y="505" font-size="9" fill="white">Cobertura Completa</text>

            <circle cx="30" cy="520" r="4" fill="#F59E0B"/>
            <text x="40" y="525" font-size="9" fill="white">Cobertura Parcial</text>

            <circle cx="30" cy="540" r="4" fill="#6B7280"/>
            <text x="40" y="545" font-size="9" fill="white">Planificado 2026-2027</text>
          </svg>
        </div>
        <p class="text-sm text-slate-400 mt-4 text-center">
          Mapa de cobertura REP — Expandiéndose a todo Chile
        </p>
      </div>

      <!-- Legend & Info -->
      <div class="space-y-6">
        <!-- Coverage Legend -->
        <div class="bg-slate-800/50 border border-slate-700 rounded-xl p-6">
          <h3 class="text-lg font-bold text-white mb-4">Estado de Cobertura</h3>
          <div class="space-y-3">
            <div class="flex items-center gap-3">
              <div class="w-4 h-4 rounded" style="background-color: #10B981;"></div>
              <div>
                <p class="text-sm font-semibold text-white">Cobertura Completa</p>
                <p class="text-xs text-slate-400">9 regiones activas</p>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-4 h-4 rounded" style="background-color: #F59E0B;"></div>
              <div>
                <p class="text-sm font-semibold text-white">Cobertura Parcial</p>
                <p class="text-xs text-slate-400">4 regiones en expansión</p>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-4 h-4 rounded" style="background-color: #6B7280;"></div>
              <div>
                <p class="text-sm font-semibold text-white">Planificado</p>
                <p class="text-xs text-slate-400">2 regiones para 2027</p>
              </div>
            </div>
          </div>
        </div>

        <!-- La Serena Spotlight -->
        <div class="bg-gradient-to-br from-amber-500/20 to-amber-600/10 border border-amber-500/30 rounded-xl p-6">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-xl">📍</span>
            <h3 class="text-lg font-bold text-white">Sede La Serena</h3>
          </div>
          <p class="text-sm text-slate-300 mb-4">
            Oficina operativa en La Serena, Región de Coquimbo. Hub logístico para recolección y coordinación de partners certificados en la zona.
          </p>
          <div class="text-xs text-amber-400 font-mono">
            <p>📧 contacto@electroloop.cl</p>
            <p>🚀 Operativo: Julio 2026</p>
          </div>
        </div>

        <!-- Partner Count -->
        <div class="bg-slate-800/50 border border-slate-700 rounded-xl p-6 text-center">
          <p class="text-3xl font-bold text-amber-500 mb-2">15+</p>
          <p class="text-sm text-slate-400">Partners certificados SMA</p>
        </div>
      </div>
    </div>

    <!-- Regional Details Table (Hidden on mobile, visible on desktop) -->
    <div class="mt-12 hidden md:block bg-slate-800/30 border border-slate-700 rounded-xl overflow-hidden">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-slate-700 bg-slate-800/50">
            <th class="px-6 py-3 text-left text-slate-300 font-semibold">Región</th>
            <th class="px-6 py-3 text-left text-slate-300 font-semibold">Estado</th>
            <th class="px-6 py-3 text-right text-slate-300 font-semibold">Partners</th>
          </tr>
        </thead>
        <tbody>
          {regions.map((region) => (
            <tr class={`border-b border-slate-700/50 hover:bg-slate-800/50 transition-colors ${region.active ? 'bg-amber-500/10' : ''}`}>
              <td class={`px-6 py-3 font-medium ${region.active ? 'text-amber-400' : 'text-white'}`}>
                {region.name}
                {region.active && <span class="ml-2 text-xs bg-amber-500 text-white px-2 py-0.5 rounded">HQ</span>}
              </td>
              <td class="px-6 py-3">
                <span class={`px-3 py-1 rounded-full text-xs font-semibold ${
                  region.compliance === 'completo'
                    ? 'bg-green-500/20 text-green-300'
                    : region.compliance === 'parcial'
                    ? 'bg-amber-500/20 text-amber-300'
                    : 'bg-slate-600/20 text-slate-300'
                }`}>
                  {region.compliance === 'completo' ? 'Completo' : region.compliance === 'parcial' ? 'Parcial' : 'Planificado'}
                </span>
              </td>
              <td class="px-6 py-3 text-right text-slate-400">
                {region.compliance === 'completo' ? '2-3' : region.compliance === 'parcial' ? '1' : 'TBD'}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<script type="module">
  import * as d3 from 'd3';

  const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
  const prefersNoMotion = motionQuery.matches;

  // Note: Full D3 TopoJSON implementation would require a Chile TopoJSON file
  // For now, we're using the SVG fallback with CSS enhancements
  // Full map implementation would go here with D3 path generation

  console.log('✓ BLOQUE 3b: Mapa REP Chile initialized');
  console.log('✓ Regional coverage visualization active');
  console.log('✓ SVG fallback rendering active');

  // Add interactive region hover effects
  const regionElements = document.querySelectorAll('.region');
  regionElements.forEach((region) => {
    region.style.cursor = 'pointer';
    region.addEventListener('mouseenter', () => {
      region.style.opacity = '1';
      region.style.filter = 'brightness(1.2)';
    });
    region.addEventListener('mouseleave', () => {
      region.style.filter = 'brightness(1)';
      region.style.opacity = region.classList.contains('active') ? '0.9' : '0.7';
    });
  });
</script>

<style>
  #chile-map {
    filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.3));
  }

  .region {
    transition: opacity 0.3s, filter 0.3s;
  }

  .region.active {
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 0.9;
    }
    50% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .region.active {
      animation: none;
    }
  }
</style>
