---
// Status.astro — Roadmap + Regulatory authorization timeline with modern dark glassmorphic design
// Q3 2026 (Now) → Operations launch August 2026
---

<section id="estado" class="relative w-full py-32 overflow-hidden bg-gradient-to-b from-slate-900 via-slate-800 to-slate-900">
  <!-- Background accent elements -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-20 left-0 w-96 h-96 bg-blue-500/20 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl"></div>
  </div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Header -->
    <div class="text-center mb-20">
      <div class="inline-block mb-4">
        <span class="inline-block text-xs font-bold tracking-widest uppercase px-4 py-2 rounded-full" style="background: rgba(251, 146, 60, 0.1); color: #FB923C;">
          Estado de Electroloop
        </span>
      </div>
      <h2 class="text-5xl md:text-6xl font-bold text-white mb-6 leading-tight">
        Roadmap <span class="text-amber-500">Regulatorio</span>
      </h2>
      <p class="text-lg text-slate-400 max-w-3xl mx-auto">
        Trazabilidad completa de nuestro progreso hacia la autorización agosto 2026
      </p>
    </div>

    <!-- Two-column layout -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start mb-16">

      <!-- Left: Timeline/Phases -->
      <div>
        <h3 class="text-2xl font-bold mb-8 text-white">Fases de Estructuración</h3>

        <!-- Phase cards -->
        <div class="flex flex-col gap-6">
          <!-- Phase 1: Now -->
          <div class="group relative">
            <div class="absolute inset-0 bg-gradient-to-br from-amber-500/10 to-orange-500/5 rounded-2xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <div class="relative bg-slate-800/50 backdrop-blur-xl border border-slate-700/50 rounded-2xl p-6 hover:border-amber-500/30 transition-all duration-300 hover:shadow-xl hover:shadow-amber-500/10">
              <div class="flex items-center gap-3 mb-3">
                <div class="w-3 h-3 rounded-full bg-amber-400"></div>
                <span class="text-xs font-bold px-3 py-1 rounded-full bg-amber-500/20 text-amber-400">
                  Q3 2026 — Ahora
                </span>
              </div>
              <h4 class="text-lg font-bold text-white mb-2">
                Estructuración Legal & Operativa
              </h4>
              <p class="text-sm text-slate-400 leading-relaxed">
                Preparando documentación regulatoria, validando partners certificados, estructurando sistemas de trazabilidad digital.
              </p>
            </div>
          </div>

          <!-- Phase 2: Q3 Late -->
          <div class="group relative">
            <div class="absolute inset-0 bg-gradient-to-br from-amber-500/10 to-orange-500/5 rounded-2xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <div class="relative bg-slate-800/50 backdrop-blur-xl border border-slate-700/50 rounded-2xl p-6 hover:border-amber-500/30 transition-all duration-300 hover:shadow-xl hover:shadow-amber-500/10">
              <div class="flex items-center gap-3 mb-3">
                <div class="w-3 h-3 rounded-full bg-amber-400/60"></div>
                <span class="text-xs font-bold px-3 py-1 rounded-full bg-amber-500/20 text-amber-400">
                  Agosto 2026
                </span>
              </div>
              <h4 class="text-lg font-bold text-white mb-2">
                Operaciones Piloto
              </h4>
              <p class="text-sm text-slate-400 leading-relaxed">
                Lanzamiento operativo con clientes ancla (productores, generadores III-IV región). Retiros certificados con partners.
              </p>
            </div>
          </div>

          <!-- Phase 3: Future -->
          <div class="group relative">
            <div class="absolute inset-0 bg-gradient-to-br from-slate-600/10 to-slate-700/5 rounded-2xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <div class="relative bg-slate-800/30 backdrop-blur-xl border border-slate-700/30 rounded-2xl p-6 hover:border-slate-600/50 transition-all duration-300 hover:shadow-xl hover:shadow-slate-500/5">
              <div class="flex items-center gap-3 mb-3">
                <div class="w-3 h-3 rounded-full bg-slate-500/60"></div>
                <span class="text-xs font-bold px-3 py-1 rounded-full bg-slate-700/40 text-slate-300">
                  2027+
                </span>
              </div>
              <h4 class="text-lg font-bold text-slate-300 mb-2">
                Internalización & Expansión
              </h4>
              <p class="text-sm text-slate-400 leading-relaxed">
                Capacidad propia (destrucción de datos, desmantelamiento). Expansión a macrozona norte completa.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Regulatory Checklist -->
      <div>
        <h3 class="text-2xl font-bold mb-8 text-white">Autoridades & Plazos</h3>

        <!-- Checklist table -->
        <div class="space-y-4">
          {[
            {
              authority: 'Ministerio del Medio Ambiente',
              requirement: 'Registro de Gestor RAEE',
              status: 'in-progress',
              statusLabel: 'En estructuración',
              timeline: 'Agosto 2026'
            },
            {
              authority: 'SEREMI de Salud (Regional)',
              requirement: 'Autorización Sanitaria',
              status: 'in-progress',
              statusLabel: 'En elaboración de expediente',
              timeline: 'Agosto 2026'
            },
            {
              authority: 'Partners Certificados',
              requirement: 'Validación de operadores',
              status: 'completed',
              statusLabel: 'Validado',
              timeline: 'Q3 2026'
            },
            {
              authority: 'Sistema Interno',
              requirement: 'Trazabilidad digital',
              status: 'completed',
              statusLabel: 'Operativo',
              timeline: 'Q3 2026'
            }
          ].map((item) => (
            <div
              class={`bg-slate-800/50 backdrop-blur-xl border rounded-2xl p-4 transition-all duration-300 ${
                item.status === 'completed'
                  ? 'border-green-500/30 hover:border-green-500/50 hover:shadow-lg hover:shadow-green-500/10'
                  : 'border-amber-500/30 hover:border-amber-500/50 hover:shadow-lg hover:shadow-amber-500/10'
              }`}
            >
              <div class="flex items-start gap-4">
                <!-- Icon -->
                <div
                  class={`w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5 ${
                    item.status === 'completed'
                      ? 'bg-green-500/20'
                      : 'bg-amber-500/20'
                  }`}
                  aria-hidden="true"
                >
                  {item.status === 'completed' ? (
                    <svg class="w-4 h-4 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    </svg>
                  ) : (
                    <svg class="w-4 h-4 text-amber-400 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <circle cx="12" cy="12" r="1" fill="currentColor"/>
                      <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="2" fill="none" opacity="0.6"/>
                    </svg>
                  )}
                </div>

                <!-- Content -->
                <div class="flex-1 min-w-0">
                  <div class="flex items-start justify-between gap-2 mb-1">
                    <p class="text-sm font-bold text-white">{item.authority}</p>
                    <span
                      class={`inline-flex items-center text-xs font-semibold px-2 py-1 rounded-full flex-shrink-0 whitespace-nowrap ${
                        item.status === 'completed'
                          ? 'bg-green-500/20 text-green-400'
                          : 'bg-amber-500/20 text-amber-400'
                      }`}
                    >
                      {item.statusLabel}
                    </span>
                  </div>
                  <p class="text-xs text-slate-400 mb-1.5">{item.requirement}</p>
                  <p class="text-xs font-medium text-slate-400">📅 {item.timeline}</p>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Info box -->
        <div class="mt-6 bg-slate-800/50 backdrop-blur-xl border border-slate-700/50 rounded-2xl p-5 hover:border-amber-500/30 transition-all duration-300 hover:shadow-lg hover:shadow-amber-500/10">
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 flex-shrink-0 mt-0.5 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
            </svg>
            <p class="text-xs text-slate-400 leading-relaxed">
              Operamos con partners certificados durante la fase de autorización. La trazabilidad digital garantiza cumplimiento REP desde el día uno.
            </p>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom CTA -->
    <div class="relative mt-16">
      <!-- Background gradient overlay -->
      <div class="absolute inset-0 bg-gradient-to-br from-amber-500/10 to-orange-500/5 rounded-2xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

      <!-- Glassmorphic card -->
      <div class="relative bg-slate-800/50 backdrop-blur-xl border border-slate-700/50 rounded-2xl p-8 hover:border-amber-500/30 transition-all duration-300 hover:shadow-xl hover:shadow-amber-500/10 text-center group">
        <p class="text-base text-slate-400 mb-6">
          <strong class="text-white">¿Eres productor o generador de RAEE?</strong>
          <span> Pre-regístrate ahora como cliente ancla y asegura tu lugar en el lanzamiento.</span>
        </p>
        <a
          href="#contacto"
          class="inline-flex items-center gap-2 px-8 py-3.5 rounded-xl text-sm font-bold text-white bg-amber-500 hover:bg-amber-600 transition-all duration-300 hover:shadow-lg hover:shadow-amber-500/30 hover:-translate-y-0.5"
        >
          Pre-registrarme como cliente ancla
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>

  </div>
</section>
