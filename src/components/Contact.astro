---
// Contact.astro — Modern dark glassmorphic contact form
// Netlify Forms: name="contacto-electroloop", data-netlify="true"
---

<section id="contacto" class="relative w-full py-32 overflow-hidden bg-gradient-to-b from-slate-900 via-slate-800 to-slate-900">
  <!-- Background accent elements -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-20 right-0 w-96 h-96 bg-amber-500/20 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 left-1/4 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl"></div>
  </div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Header -->
    <div class="text-center mb-20">
      <div class="inline-block mb-4">
        <span class="inline-block text-xs font-bold tracking-widest uppercase px-4 py-2 rounded-full" style="background: rgba(251, 146, 60, 0.1); color: #FB923C;">
          Contacto
        </span>
      </div>
      <h2 class="text-5xl md:text-6xl font-bold text-white mb-6 leading-tight">
        <span class="text-amber-500">Conversemos</span>
      </h2>
      <p class="text-lg text-slate-400 max-w-3xl mx-auto">
        Cuéntanos sobre tu necesidad de gestión de residuos electrónicos y te contactaremos en los próximos días.
      </p>
    </div>

    <!-- Two-column layout -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">

      <!-- Left: Form -->
      <div class="group relative">
        <div class="absolute inset-0 bg-gradient-to-br from-amber-500/10 to-orange-500/5 rounded-2xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <div class="relative bg-slate-800/50 backdrop-blur-xl border border-slate-700/50 rounded-2xl p-8 hover:border-amber-500/30 transition-all duration-300 hover:shadow-xl hover:shadow-amber-500/10">
          <form
            id="contact-form"
            name="contacto-electroloop"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
            class="flex flex-col gap-6"
            novalidate
          >
            <input type="hidden" name="form-name" value="contacto-electroloop" />
            <p class="hidden">
              <label>No llenar: <input name="bot-field" /></label>
            </p>

            <!-- Name -->
            <div>
              <label for="contact-name" class="block text-sm font-semibold text-white mb-2" data-i18n="contact.fields.name">
                Nombre completo
              </label>
              <input
                type="text"
                id="contact-name"
                name="name"
                class="w-full bg-slate-700/50 border border-slate-600/50 rounded-lg px-4 py-3 text-white placeholder-slate-400 focus:outline-none focus:border-amber-500/50 focus:bg-slate-700/70 transition-all duration-200"
                placeholder="Tu nombre"
                required
                autocomplete="name"
                data-i18n-placeholder="contact.placeholders.name"
              />
            </div>

            <!-- Email -->
            <div>
              <label for="contact-email" class="block text-sm font-semibold text-white mb-2" data-i18n="contact.fields.email">
                Correo electrónico
              </label>
              <input
                type="email"
                id="contact-email"
                name="email"
                class="w-full bg-slate-700/50 border border-slate-600/50 rounded-lg px-4 py-3 text-white placeholder-slate-400 focus:outline-none focus:border-amber-500/50 focus:bg-slate-700/70 transition-all duration-200"
                placeholder="tu@empresa.cl"
                required
                autocomplete="email"
                data-i18n-placeholder="contact.placeholders.email"
              />
            </div>

            <!-- Company -->
            <div>
              <label for="contact-company" class="block text-sm font-semibold text-white mb-2" data-i18n="contact.fields.company">
                Empresa / Organización
              </label>
              <input
                type="text"
                id="contact-company"
                name="company"
                class="w-full bg-slate-700/50 border border-slate-600/50 rounded-lg px-4 py-3 text-white placeholder-slate-400 focus:outline-none focus:border-amber-500/50 focus:bg-slate-700/70 transition-all duration-200"
                placeholder="Nombre de tu empresa"
                autocomplete="organization"
                data-i18n-placeholder="contact.placeholders.company"
              />
            </div>

            <!-- Type -->
            <div>
              <label for="contact-type" class="block text-sm font-semibold text-white mb-2" data-i18n="contact.fields.type">
                Tipo de consulta
              </label>
              <select
                id="contact-type"
                name="type"
                class="w-full bg-slate-700/50 border border-slate-600/50 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-amber-500/50 focus:bg-slate-700/70 transition-all duration-200"
                required
              >
                <option value="" disabled selected style="color: #94a3b8;" data-i18n="contact.placeholders.type">Selecciona una opción</option>
                <option value="quote" style="color: #f8fafc;" data-i18n="contact.types.0">Cotización de servicio</option>
                <option value="rep" style="color: #f8fafc;" data-i18n="contact.types.1">Cumplimiento REP</option>
                <option value="info" style="color: #f8fafc;" data-i18n="contact.types.2">Información general</option>
                <option value="other" style="color: #f8fafc;" data-i18n="contact.types.3">Otro</option>
              </select>
            </div>

            <!-- Message -->
            <div>
              <label for="contact-message" class="block text-sm font-semibold text-white mb-2" data-i18n="contact.fields.message">
                Mensaje
              </label>
              <textarea
                id="contact-message"
                name="message"
                rows="4"
                class="w-full bg-slate-700/50 border border-slate-600/50 rounded-lg px-4 py-3 text-white placeholder-slate-400 focus:outline-none focus:border-amber-500/50 focus:bg-slate-700/70 transition-all duration-200 resize-none"
                placeholder="Describe tu necesidad..."
                required
                data-i18n-placeholder="contact.placeholders.message"
              ></textarea>
            </div>

            <!-- Submit -->
            <button
              type="submit"
              id="submit-btn"
              class="inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl text-sm font-bold text-white bg-amber-500 hover:bg-amber-600 transition-all duration-300 hover:shadow-lg hover:shadow-amber-500/30 hover:-translate-y-0.5 disabled:opacity-60 disabled:cursor-not-allowed disabled:transform-none"
              data-i18n="contact.fields.send"
            >
              <svg
                id="submit-spinner"
                class="w-4 h-4 hidden animate-spin"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
              </svg>
              <span id="submit-text">Enviar Mensaje</span>
              <svg
                class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </button>

            <!-- Success / Error messages -->
            <div
              id="form-success"
              class="hidden flex items-center gap-3 p-4 rounded-xl bg-green-500/10 border border-green-500/30"
              role="alert"
              aria-live="polite"
            >
              <svg class="w-5 h-5 flex-shrink-0 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span class="text-sm font-medium text-green-400" data-i18n="contact.success">
                ¡Mensaje enviado! Te contactaremos pronto.
              </span>
            </div>

            <div
              id="form-error"
              class="hidden flex items-center gap-3 p-4 rounded-xl bg-red-500/10 border border-red-500/30"
              role="alert"
              aria-live="polite"
            >
              <svg class="w-5 h-5 flex-shrink-0 text-red-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
              </svg>
              <span class="text-sm font-medium text-red-400" data-i18n="contact.error">
                Hubo un error. Por favor intenta nuevamente.
              </span>
            </div>

          </form>
        </div>
      </div>

      <!-- Right: Contact info -->
      <div class="space-y-6">
        <!-- Info Card 1: Email -->
        <div class="group relative">
          <div class="absolute inset-0 bg-gradient-to-br from-amber-500/10 to-orange-500/5 rounded-2xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative bg-slate-800/50 backdrop-blur-xl border border-slate-700/50 rounded-2xl p-6 hover:border-amber-500/30 transition-all duration-300 hover:shadow-xl hover:shadow-amber-500/10">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-lg bg-amber-500/20 flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-amber-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-bold text-white mb-1">Email</h3>
                <p class="text-slate-400">
                  <a href="mailto:contacto@electroloop.cl" class="text-amber-400 hover:text-amber-300 transition-colors">
                    contacto@electroloop.cl
                  </a>
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Info Card 2: Location -->
        <div class="group relative">
          <div class="absolute inset-0 bg-gradient-to-br from-amber-500/10 to-orange-500/5 rounded-2xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative bg-slate-800/50 backdrop-blur-xl border border-slate-700/50 rounded-2xl p-6 hover:border-amber-500/30 transition-all duration-300 hover:shadow-xl hover:shadow-amber-500/10">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-lg bg-amber-500/20 flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-amber-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-bold text-white mb-1">Ubicación</h3>
                <p class="text-slate-400">
                  Región IV de Coquimbo<br/>
                  <span class="text-sm">La Serena, Chile</span>
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Info Card 4: Hours -->
        <div class="group relative">
          <div class="absolute inset-0 bg-gradient-to-br from-amber-500/10 to-orange-500/5 rounded-2xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative bg-slate-800/50 backdrop-blur-xl border border-slate-700/50 rounded-2xl p-6 hover:border-amber-500/30 transition-all duration-300 hover:shadow-xl hover:shadow-amber-500/10">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-lg bg-amber-500/20 flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-amber-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-bold text-white mb-1">Horario</h3>
                <p class="text-slate-400">
                  Lunes - Viernes<br/>
                  <span class="text-sm">9:00 AM - 6:00 PM CLT</span>
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>


<script>
  // Form submission with Netlify Forms
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const submitSpinner = document.getElementById('submit-spinner');
  const submitText = document.getElementById('submit-text');
  const successMsg = document.getElementById('form-success');
  const errorMsg = document.getElementById('form-error');

  if (form && submitBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Show spinner
      if (submitSpinner) submitSpinner.classList.remove('hidden');
      if (submitText) submitText.textContent = 'Enviando...';
      submitBtn.disabled = true;

      // Hide previous messages
      successMsg?.classList.add('hidden');
      errorMsg?.classList.add('hidden');

      try {
        const formData = new FormData(form);

        // 1. POST a Netlify Forms (captura submission + envía notificación a contacto@)
        const encoded: string[] = [];
        formData.forEach((value, key) => {
          encoded.push(encodeURIComponent(key) + '=' + encodeURIComponent(value.toString()));
        });

        const response = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: encoded.join('&'),
        });

        if (response.status < 400) {
          // 2. Llamar Netlify Function para enviar autorespuesta vía Gmail SMTP
          const email = (formData.get('email') as string) || '';
          const name  = (formData.get('name')  as string) || '';

          if (email && name) {
            try {
              await fetch('/.netlify/functions/send-autoresponse', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email, name }),
              });
            } catch (e) {
              console.warn('Autoresponse error:', e);
              // No mostramos error al usuario — el form ya fue capturado por Netlify
            }
          }

          successMsg?.classList.remove('hidden');
          form.reset();
        } else {
          console.error('Netlify form error, status:', response.status);
          errorMsg?.classList.remove('hidden');
        }
      } catch (_err) {
        console.error('Form submit error:', _err);
        errorMsg?.classList.remove('hidden');
      } finally {
        if (submitSpinner) submitSpinner.classList.add('hidden');
        const lang = localStorage.getItem('electroloop-lang') || 'es';
        if (submitText) submitText.textContent = lang === 'es' ? 'Enviar Mensaje' : 'Send Message';
        submitBtn.disabled = false;
      }
    });
  }
</script>
